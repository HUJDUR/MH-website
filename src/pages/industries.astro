---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Reveal from '../components/Reveal.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CallToAction from '../components/CallToAction.astro';
import { industries } from '../data/content';
import { img } from '../data/images';
---

<Base
  title="Industries"
  description="Metal Holland fabricates for shipbuilding and yachtbuilding, offshore and energy, infrastructure and bridges, and industrial machine building."
  transparentHeader
>
  <PageHero
    eyebrow="Industries"
    title="Where our steel ends up."
    lede="Hulls, platforms, bridges and machines. Different rules, different paperwork, the same shop floor discipline behind all of them."
    image="industry-shipbuilding"
    imageAlt="A vessel at sea at sunset"
    position="center 60%"
  />

  <div class="divide-y divide-white/8">
    {
      industries.map((industry, i) => (
        <section id={industry.id} class="scroll-mt-24 py-20 lg:py-28">
          <div class="shell grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
            <Reveal
              class:list={[
                'relative overflow-hidden rounded-2xl lg:col-span-7',
                i % 2 === 1 && 'lg:order-2 lg:col-start-6',
              ]}
            >
              <Image
                src={img(industry.image)}
                alt={industry.title}
                widths={[600, 1000, 1500]}
                sizes="(min-width:1024px) 56vw, 92vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                class="aspect-16/10 w-full object-cover"
              />
            </Reveal>

            <div
              class:list={[
                'lg:col-span-5',
                i % 2 === 1 ? 'lg:order-1 lg:col-start-1' : 'lg:col-start-8',
              ]}
            >
              <Reveal>
                <p class="eyebrow-arc">
                  {String(i + 1).padStart(2, '0')} — Sector
                </p>
              </Reveal>
              <Reveal delay={80}>
                <h2 class="mt-4 text-3xl leading-[1.1] sm:text-4xl">
                  {industry.title}
                </h2>
              </Reveal>
              <Reveal delay={140}>
                <p class="mt-5 text-lg leading-relaxed text-steel-300">
                  {industry.summary}
                </p>
              </Reveal>
              <Reveal delay={200}>
                <ul class="mt-8 space-y-px overflow-hidden rounded-xl border border-white/8">
                  {industry.bullets.map((bullet) => (
                    <li class="bg-white/2 px-5 py-3.5 text-sm text-steel-200">
                      {bullet}
                    </li>
                  ))}
                </ul>
              </Reveal>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <!-- ── Why clients come to us ────────────────────────────────────────── -->
  <section class="border-t border-white/8 bg-ink-900 py-24 lg:py-32">
    <div class="shell">
      <SectionHeading
        eyebrow="Working with us"
        title="What a fabrication partner is actually for."
        align="center"
      />

      <div class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-white/8 bg-white/8 md:grid-cols-3">
        {
          [
            {
              title: 'Capacity that absorbs a peak',
              body: 'Yards and OEMs use us to take the overflow their own shop cannot swallow without pushing everything else back.',
            },
            {
              title: 'One party, whole scope',
              body: 'Cutting, welding, coating and transport come from us. There is no gap between suppliers for a problem to fall into.',
            },
            {
              title: 'Documentation that survives audit',
              body: 'Certificates, procedures and inspection records are gathered as the work runs, so handover is not an archaeology exercise.',
            },
          ].map((item, i) => (
            <Reveal delay={i * 100} class="bg-ink-900 p-8 lg:p-10">
              <h3 class="text-xl leading-snug">{item.title}</h3>
              <p class="mt-4 text-sm leading-relaxed text-steel-400">
                {item.body}
              </p>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <CallToAction
    title="Your sector not listed?"
    body="If it is heavy, welded and made of steel, it is probably work we know. Tell us what you are building."
    image="hall-overview"
  />
</Base>
