---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Reveal from '../../components/Reveal.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CallToAction from '../../components/CallToAction.astro';

import { img } from '../../data/images';
import { localePaths, t, href, localeMeta } from '../../i18n';
import type { Locale } from '../../i18n';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
const L = (path: string) => href(locale, path);

---

<Base
  locale={locale}
  title={d.industriesPage.title}
  description={d.industriesPage.description}
  transparentHeader
>
  <PageHero
    eyebrow={d.industriesPage.eyebrow}
    title={d.industriesPage.heroTitle}
    lede={d.industriesPage.heroLede}
    image="industry-shipbuilding"
    imageAlt={d.industriesPage.heroAlt}
    position="center 60%"
  />

  <div class="divide-y divide-line/8">
    {
      d.content.industries.map((industry, i) => (
        <section id={industry.id} class="scroll-mt-24 py-20 lg:py-28">
          <div class="shell grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
            <Reveal
              class:list={[
                'relative overflow-hidden rounded-2xl lg:col-span-7',
                i % 2 === 1 && 'lg:order-2 lg:col-start-6',
              ]}
            >
              <Image
                src={img(industry.image)}
                alt={industry.title}
                widths={[600, 1000, 1500]}
                sizes="(min-width:1024px) 56vw, 92vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                class="aspect-16/10 w-full object-cover"
              />
            </Reveal>

            <div
              class:list={[
                'lg:col-span-5',
                i % 2 === 1 ? 'lg:order-1 lg:col-start-1' : 'lg:col-start-8',
              ]}
            >
              <Reveal>
                <p class="eyebrow-arc">
                  {String(i + 1).padStart(2, '0')} — {d.common.sector}
                </p>
              </Reveal>
              <Reveal delay={80}>
                <h2 class="mt-4 text-3xl leading-[1.1] sm:text-4xl">
                  {industry.title}
                </h2>
              </Reveal>
              <Reveal delay={140}>
                <p class="mt-5 text-lg leading-relaxed text-steel-300">
                  {industry.summary}
                </p>
              </Reveal>
              <Reveal delay={200}>
                <ul class="mt-8 space-y-px overflow-hidden rounded-xl border border-line/8">
                  {industry.bullets.map((bullet) => (
                    <li class="bg-line/2 px-5 py-3.5 text-sm text-steel-200">
                      {bullet}
                    </li>
                  ))}
                </ul>
              </Reveal>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <!-- ── Why clients come to us ────────────────────────────────────────── -->
  <section class="border-t border-line/8 bg-ink-900 py-24 lg:py-32">
    <div class="shell">
      <SectionHeading
        eyebrow={d.industriesPage.workingEyebrow}
        title={d.industriesPage.workingTitle}
        align="center"
      />

      <div class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-line/8 bg-line/8 md:grid-cols-3">
        {
          d.industriesPage.working.map((item, i) => (
            <Reveal delay={i * 100} class="bg-ink-900 p-8 lg:p-10">
              <h3 class="text-xl leading-snug">{item.title}</h3>
              <p class="mt-4 text-sm leading-relaxed text-steel-400">
                {item.body}
              </p>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <CallToAction
    locale={locale}
    title={d.industriesPage.ctaTitle}
    body={d.industriesPage.ctaBody}
    image="hall-overview"
  />
</Base>
