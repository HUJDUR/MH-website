---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Reveal from '../../components/Reveal.astro';
import { contact, site } from '../../data/site';

import { localePaths, t, href, localeMeta } from '../../i18n';
import type { Locale } from '../../i18n';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
const L = (path: string) => href(locale, path);

/**
 * The site is static, so submissions go through Web3Forms, which forwards
 * them to info@metalholland.com. Web3Forms stores nothing — it relays.
 *
 * The access key is a submit-only credential and is public by design: it
 * cannot read past submissions or reach the account. Any key the browser
 * uses is visible to the browser, so do not treat this as a secret. The
 * protection that matters is the domain allowlist in the Web3Forms
 * dashboard — restrict this key to metalholland.com so nobody can post to
 * it from elsewhere.
 */
const FORM_ENDPOINT = 'https://api.web3forms.com/submit';
const WEB3FORMS_KEY = '64977760-c428-4e97-af05-a8eec75b5c8e';

const fieldClass =
  'w-full rounded-xl border border-line/12 bg-ink-900 px-4 py-3.5 text-sm text-heading placeholder:text-steel-400 transition-colors duration-300 focus:border-flame-500 focus:outline-none';
const labelClass =
  'mb-2 block font-display text-xs font-semibold uppercase tracking-[0.14em] text-steel-300';
---

<Base
  locale={locale}
  title={d.contactPage.title}
  description={d.contactPage.description}
  transparentHeader
>
  <PageHero
    eyebrow={d.contactPage.eyebrow}
    title={d.contactPage.heroTitle}
    lede={d.contactPage.heroLede}
    image="welding-dark"
    imageAlt={d.contactPage.heroAlt}
  />

  <section class="shell py-20 lg:py-28">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
      <!-- ── Form ──────────────────────────────────────────────────────── -->
      <div class="lg:col-span-7">
        <Reveal>
          <h2 class="text-2xl sm:text-3xl">{d.contactPage.formTitle}</h2>
          <p class="mt-3 text-sm leading-relaxed text-steel-400">{d.contactPage.formNote}</p>
        </Reveal>

        <Reveal delay={120}>
          <form
            data-web3-form
            data-subject-field="company"
            data-endpoint={FORM_ENDPOINT}
            data-msg-sending={d.contactPage.sending}
            data-msg-success={d.contactPage.success}
            data-msg-error={d.contactPage.error}
            data-msg-subject={d.contactPage.subject}
            class="mt-10 grid gap-5 sm:grid-cols-2"
            method="post"
            action={FORM_ENDPOINT}
          >
            <!-- Web3Forms configuration fields. These are read by the API and
                 never appear in the body of the email. -->
            <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
            <input type="hidden" name="from_name" value={`${site.name} website`} />
            <input
              type="hidden"
              name="subject"
              value="Quote request via metalholland.com"
            />
            <div>
              <label class={labelClass} for="name">{d.contactPage.fields.name} *</label>
              <input
                class={fieldClass}
                id="name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder={d.contactPage.fields.namePlaceholder}
              />
            </div>

            <div>
              <label class={labelClass} for="company">{d.contactPage.fields.company} *</label>
              <input
                class={fieldClass}
                id="company"
                name="company"
                type="text"
                required
                autocomplete="organization"
                placeholder={d.contactPage.fields.companyPlaceholder}
              />
            </div>

            <div>
              <label class={labelClass} for="email">{d.contactPage.fields.email} *</label>
              <input
                class={fieldClass}
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder={d.contactPage.fields.emailPlaceholder}
              />
            </div>

            <div>
              <label class={labelClass} for="phone">{d.contactPage.fields.phone}</label>
              <input
                class={fieldClass}
                id="phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                placeholder={d.contactPage.fields.phonePlaceholder}
              />
            </div>

            <div class="sm:col-span-2">
              <label class={labelClass} for="sector">{d.contactPage.fields.sector}</label>
              <div class="relative">
                <select class={`${fieldClass} appearance-none pr-10`} id="sector" name="sector">
                  <option value="">{d.contactPage.fields.sectorPlaceholder}</option>
                  {
                    d.content.industries.map((industry) => (
                      <option value={industry.title}>{industry.title}</option>
                    ))
                  }
                  <option value="Other">{d.contactPage.fields.sectorOther}</option>
                </select>
                <svg
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                  class="pointer-events-none absolute right-4 top-1/2 h-3 w-3 -translate-y-1/2 text-steel-400"
                >
                  <path
                    d="M3 6l5 5 5-5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </div>
            </div>

            <div class="sm:col-span-2">
              <label class={labelClass} for="message">
                {d.contactPage.fields.message} *
              </label>
              <textarea
                class={fieldClass}
                id="message"
                name="message"
                rows="6"
                required
                placeholder={d.contactPage.fields.messagePlaceholder}
              ></textarea>
            </div>

            <!-- Honeypot. Web3Forms rejects the submission if `botcheck` comes
                 back ticked, which only a bot filling every field would do. -->
            <input
              type="checkbox"
              name="botcheck"
              class="hidden"
              style="display:none"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />

            <div class="sm:col-span-2 sm:flex sm:items-center sm:gap-5">
              <button
                type="submit"
                class="w-full rounded-full bg-flame-500 px-7 py-4 text-sm font-semibold text-white transition-all duration-300 hover:bg-flame-400 hover:shadow-[0_0_40px_-8px] hover:shadow-flame-500/80 disabled:opacity-60 sm:w-auto"
              >
                {d.contactPage.submit}
              </button>
              <p
                data-form-status
                role="status"
                class="mt-4 text-sm text-steel-400 sm:mt-0"
              >
              </p>
              <a
                data-form-fallback
                hidden
                href={`mailto:${contact.email}`}
                class="mt-2 text-sm text-flame-500 underline-offset-4 hover:underline sm:mt-0"
              >
                {contact.email}
              </a>
            </div>
          </form>
        </Reveal>
      </div>

      <!-- ── Details ───────────────────────────────────────────────────── -->
      <div class="lg:col-span-4 lg:col-start-9">
        <Reveal delay={200}>
          <div class="rounded-2xl border border-line/8 bg-ink-900 p-8">
            <h2 class="font-display text-xs font-semibold uppercase tracking-[0.18em] text-flame-500">
              {d.contactPage.directTitle}
            </h2>
            <div class="mt-6 space-y-5">
              <div>
                <p class="text-xs text-steel-400">{d.contactPage.emailLabel}</p>
                <a
                  href={`mailto:${contact.email}`}
                  class="mt-1 block text-base text-heading transition-colors hover:text-flame-500"
                >
                  {contact.email}
                </a>
              </div>
              <div>
                <p class="text-xs text-steel-400">{d.contactPage.phoneLabel}</p>
                <a
                  href={`tel:${contact.phoneHref}`}
                  class="mt-1 block text-base text-heading transition-colors hover:text-flame-500"
                >
                  {contact.phone}
                </a>
              </div>
              <div>
                <p class="text-xs text-steel-400">{d.contactPage.hoursLabel}</p>
                <p class="mt-1 text-base text-heading">{d.contactPage.hours}</p>
              </div>
            </div>
          </div>
        </Reveal>

        <Reveal delay={280}>
          <div class="mt-5 grid gap-5">
            {
              [contact.works].map((location) => (
                <div class="rounded-2xl border border-line/8 p-8">
                  <h2 class="font-display text-xs font-semibold uppercase tracking-[0.18em] text-steel-400">
                    {d.footer.officeLabel}
                  </h2>
                  <address class="mt-4 text-sm not-italic leading-relaxed text-steel-200">
                    {[...location.lines, d.footer.country].map((line) => (
                      <span class="block">{line}</span>
                    ))}
                  </address>
                  <a
                    href={location.mapUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-4 inline-flex items-center gap-2 text-sm text-flame-500 transition-colors hover:text-heading"
                  >
                    {d.contactPage.directions}
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              ))
            }
          </div>
        </Reveal>

        <Reveal delay={360}>
          <p class="mt-6 text-xs leading-relaxed text-steel-400">
            {contact.registration.vat}
          </p>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ── Map ───────────────────────────────────────────────────────────── -->
  <section class="border-t border-line/8 bg-ink-900 py-20 lg:py-28">
    <div class="shell">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <h2 class="font-display text-xs font-semibold uppercase tracking-[0.18em] text-flame-500">
            {d.contactPage.mapEyebrow}
          </h2>
          <p class="mt-3 text-2xl sm:text-3xl">
            {contact.works.lines[0]}, {contact.works.lines[1]}
          </p>
        </div>
        <a
          href={contact.works.mapUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm text-steel-200 transition-colors hover:text-flame-500"
        >
          {d.contactPage.openInMaps}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <Reveal delay={120}>
        <!-- The iframe is injected by CookieConsent.astro once cookies are
             accepted; until then only the placeholder below is shown. -->
        <div
          data-consent-embed
          data-embed-src={contact.works.mapEmbedUrl}
          data-embed-title={`${d.contactPage.mapTitle} ${site.name}, ${contact.works.lines.join(', ')}`}
          data-embed-class="block h-[380px] w-full border-0 lg:h-[460px]"
          class="mt-10 overflow-hidden rounded-2xl border border-line/8 bg-ink-950"
        >
          <div
            data-embed-placeholder
            class="flex h-[380px] flex-col items-center justify-center gap-5 px-6 text-center lg:h-[460px]"
          >
            <p class="max-w-md text-sm leading-relaxed text-steel-300">{d.contactPage.mapConsent}</p>
            <div class="flex flex-col gap-3 sm:flex-row">
              <button
                type="button"
                data-load-map
                class="rounded-full bg-flame-500 px-6 py-3 text-sm font-semibold text-white transition-all duration-300 hover:bg-flame-400 hover:shadow-[0_0_40px_-8px] hover:shadow-flame-500/80"
              >
                {d.contactPage.loadMap}
              </button>
              <a
                href={contact.works.mapUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-line/15 px-6 py-3 text-sm font-semibold text-heading transition-colors duration-300 hover:border-line/40"
              >
                {d.contactPage.openInMaps}
              </a>
            </div>
          </div>
        </div>
      </Reveal>
    </div>
  </section>
</Base>

<script>
  import { initWeb3Forms } from '../../scripts/web3form';

  initWeb3Forms();
</script>

<script>
  // "Load map" doubles as a consent grant — the map is the only thing on the
  // site that sets third-party cookies.
  document
    .querySelector<HTMLButtonElement>('[data-load-map]')
    ?.addEventListener('click', () => window.mhCookieConsent?.set('all'));
</script>
