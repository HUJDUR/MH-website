---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Reveal from '../../components/Reveal.astro';
import AmbientVideo from '../../components/AmbientVideo.astro';
import CallToAction from '../../components/CallToAction.astro';

import { img } from '../../data/images';
import { localePaths, t, asset } from '../../i18n';
import type { Locale } from '../../i18n';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const d = t(locale);

/**
 * The "all" pill carries an empty value rather than a label, so the filter
 * script keeps working when the labels are translated.
 */
const filters = [
  { value: '', label: d.mediaPage.all },
  ...d.mediaPage.groups.map((g) => ({ value: g.id, label: g.label })),
];
---

<Base
  locale={locale}
  title={d.mediaPage.title}
  description={d.mediaPage.description}
  transparentHeader
>
  <PageHero
    eyebrow={d.mediaPage.eyebrow}
    title={d.mediaPage.heroTitle}
    image="truss-assembly"
    imageAlt={d.mediaPage.heroAlt}
  />

  <section class="shell py-20 lg:py-28">
    <!-- Client-side filter: progressive enhancement over a plain grid, so the
         whole album is present for crawlers and no-JS visitors. -->
    <Reveal>
      <div
        class="flex flex-wrap items-center gap-2 border-b border-line/8 pb-6"
        data-filter-bar
      >
        <span class="mr-2 text-[0.6875rem] uppercase tracking-[0.18em] text-steel-400">
          {d.mediaPage.filter}
        </span>
        {
          filters.map((f, i) => (
            <button
              type="button"
              data-filter={f.value}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="rounded-full border border-line/12 px-4 py-2 text-sm text-steel-300 transition-colors duration-300 hover:border-line/35 hover:text-heading aria-pressed:border-flame-500 aria-pressed:bg-flame-500 aria-pressed:text-white"
            >
              {f.label}
            </button>
          ))
        }
      </div>
    </Reveal>

    <div
      class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:mt-10 lg:grid-cols-4"
      data-album-grid
    >
      {
        d.mediaPage.album.map((shot, i) => (
          <Reveal
            as="figure"
            delay={(i % 4) * 70}
            data-group={shot.group}
            class="group relative overflow-hidden rounded-xl border border-line/8"
          >
            <button
              type="button"
              data-lightbox-open={i}
              class="block w-full cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-flame-500"
            >
              <Image
                src={img(shot.slug)}
                alt={shot.alt}
                widths={[400, 700, 1100, 1800]}
                sizes="(min-width:1024px) 23vw, 46vw"
                loading={i < 8 ? 'eager' : 'lazy'}
                class="aspect-4/3 w-full object-cover transition-transform duration-[1.3s] ease-[var(--ease-out-expo)] group-hover:scale-105"
              />
            </button>
          </Reveal>
        ))
      }
    </div>
  </section>

  <!-- ── Forklift clip ─────────────────────────────────────────────────── -->
  <section class="border-t border-line/8 bg-ink-900 py-20 lg:py-28">
    <div class="shell">
      <Reveal>
        <AmbientVideo
          src1080={asset("/video/forklifts-1080.mp4")}
          src720={asset("/video/forklifts-720.mp4")}
          poster={asset("/video/forklifts-poster.jpg")}
          alt={d.mediaPage.videoAlt}
          class="aspect-16/9 w-full rounded-2xl border border-line/8"
        />
      </Reveal>
    </div>
  </section>

  <CallToAction
    locale={locale}
    title={d.mediaPage.ctaTitle}
    body={d.mediaPage.ctaBody}
    image="hall-beams"
  />

  <!-- Lightbox. Empty until a photograph is opened; the <img> src is taken
       from the thumbnail's own srcset, so no second set of files is built.

       Held dark in both themes: a photograph wants a dark surround to be read
       against, and a near-white scrim over a near-white page would not read as
       a layer at all. The attribute also keeps the close button light-on-dark
       and exempts the image from the light-mode tonal lift. -->
  <div
    data-lightbox
    data-theme="dark"
    hidden
    class="fixed inset-0 z-100 hidden items-center justify-center bg-ink-950/95 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
  >
    <button
      type="button"
      data-lightbox-close
      aria-label={d.mediaPage.close}
      class="absolute right-4 top-4 z-20 rounded-full border border-line/15 p-3 text-heading transition-colors hover:border-line/40"
    >
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="h-4 w-4">
        <path
          d="M3 3l10 10M13 3L3 13"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"></path>
      </svg>
    </button>

    <!-- No caption: the alt text still names the photograph for a screen
         reader, it is just not printed under it. -->
    <img
      data-lightbox-image
      alt=""
      class="max-h-[85vh] w-full max-w-5xl rounded-lg object-contain opacity-0 transition-opacity duration-200"
    />

    {/* Full-height hit zones down each edge, so the sides of the photograph
        step through the album. Real buttons rather than listeners on the
        backdrop: they take focus, carry a label, and are reachable by keyboard
        for anyone who cannot use the arrow keys.

        They sit *under* the close button (z-10 against its z-20) because the
        top-right corner belongs to closing, and they stop short of covering
        the middle, so clicking the backdrop beside the photograph still closes
        as it always did. Tailwind v4 wraps `hover:` in `@media (hover: hover)`
        on its own, so the chevrons never stick on a touch screen. */}
    {
      (
        [
          ['prev', d.mediaPage.prev, 'left-0 justify-start pl-3 sm:pl-5', 'from-ink-950/70', '-translate-x-1', 'M10 3L5 8l5 5'],
          ['next', d.mediaPage.next, 'right-0 justify-end pr-3 sm:pr-5', 'from-ink-950/70', 'translate-x-1', 'M6 3l5 5-5 5'],
        ] as const
      ).map(([dir, label, place, grad, slide, path]) => (
        <button
          type="button"
          data-lightbox-nav={dir}
          aria-label={label}
          class:list={[
            'group absolute inset-y-0 z-10 flex w-[26%] max-w-44 items-center focus:outline-none',
            place,
          ]}
        >
          <span
            class:list={[
              'pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100',
              dir === 'prev' ? 'bg-linear-to-r' : 'bg-linear-to-l',
              grad,
              'to-transparent',
            ]}
          />
          <span
            class:list={[
              'pointer-events-none relative flex h-11 w-11 items-center justify-center rounded-full border border-line/15 bg-ink-950/40 text-heading opacity-0 transition duration-300 group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:opacity-100',
              slide,
            ]}
          >
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="h-4 w-4">
              <path
                d={path}
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </button>
      ))
    }
  </div>
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filter-bar]');
  const grid = document.querySelector<HTMLElement>('[data-album-grid]');

  if (bar && grid) {
    const buttons = bar.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const figures = grid.querySelectorAll<HTMLElement>('[data-group]');

    bar.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
        '[data-filter]'
      );
      if (!button) return;

      const group = button.dataset.filter ?? '';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      figures.forEach((fig) => {
        fig.hidden = !!group && fig.dataset.group !== group;
      });
    });
  }

  // --- Lightbox ---------------------------------------------------------
  const box = document.querySelector<HTMLElement>('[data-lightbox]');
  const boxImage = document.querySelector<HTMLImageElement>('[data-lightbox-image]');

  if (box && boxImage && grid) {
    const thumbs = [...grid.querySelectorAll<HTMLImageElement>('img')];
    let current = 0;
    let opener: HTMLElement | null = null;

    // Bumped on every show() and on close(), so a reveal that is still waiting
    // on decode() cannot paint after the visitor has moved on — arrowing
    // quickly through the album would otherwise let a slow image win the race
    // and land on top of a later one.
    let request = 0;

    const show = (index: number) => {
      // Only visible figures are navigable, so the arrows follow the filter.
      const visible = thumbs.filter((t) => !t.closest<HTMLElement>('[data-group]')!.hidden);
      if (!visible.length) return;
      current = (index + visible.length) % visible.length;
      const thumb = visible[current];
      // Largest candidate in the srcset, not the thumbnail the grid picked,
      // or opening a photograph would show it no bigger than the tile.
      const largest = thumb.srcset.split(',').pop()?.trim().split(/\s+/)[0];

      // Assigning src does not clear what is on screen: the browser keeps
      // painting the previously decoded frame until the new file is ready, so
      // opening a second photograph showed the first one for a beat. Hide the
      // element, then bring it back only once the new image has decoded.
      const mine = ++request;
      boxImage.classList.add('opacity-0');
      boxImage.alt = thumb.alt;
      boxImage.src = largest || thumb.currentSrc || thumb.src;

      const reveal = () => {
        if (mine === request) boxImage.classList.remove('opacity-0');
      };
      // decode() rejects when src is replaced mid-flight; the guard above
      // makes that harmless, and the catch keeps a decode-less browser working.
      boxImage.decode ? boxImage.decode().then(reveal).catch(reveal) : reveal();
    };

    const open = (thumb: HTMLImageElement, from: HTMLElement) => {
      const visible = thumbs.filter((t) => !t.closest<HTMLElement>('[data-group]')!.hidden);
      opener = from;
      show(visible.indexOf(thumb));
      box.hidden = false;
      box.classList.remove('hidden');
      box.classList.add('flex');
      document.body.style.overflow = 'hidden';
      box.querySelector<HTMLButtonElement>('[data-lightbox-close]')?.focus();
    };

    const close = () => {
      box.hidden = true;
      box.classList.add('hidden');
      box.classList.remove('flex');
      document.body.style.overflow = '';
      // Drop the file so a stale frame cannot survive to the next opening.
      // removeAttribute, not src = '': an empty src resolves to the page URL,
      // which the browser then requests and reports as a broken image.
      request++;
      boxImage.classList.add('opacity-0');
      boxImage.removeAttribute('src');
      boxImage.alt = '';
      opener?.focus();
    };

    grid.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>(
        '[data-lightbox-open]'
      );
      const thumb = button?.querySelector('img');
      if (button && thumb) open(thumb, button);
    });

    // A swipe ends in a click on whatever was under the finger, which would
    // step the album a second time or close it. One flag, cleared on the next
    // touchstart, swallows exactly that click.
    let swallowClick = false;

    box.addEventListener('click', (event) => {
      if (swallowClick) {
        swallowClick = false;
        return;
      }
      const target = event.target as HTMLElement;
      if (target.closest('[data-lightbox-close]')) return close();

      const nav = target.closest<HTMLElement>('[data-lightbox-nav]');
      if (nav) return show(current + (nav.dataset.lightboxNav === 'next' ? 1 : -1));

      // Only the backdrop itself closes. The photograph and the two hit zones
      // are children, so they never match.
      if (target === box) close();
    });

    // Horizontal swipe on touch. Thresholded against the vertical delta so a
    // scroll-like drag down the screen is not read as a page turn, and time-
    // boxed so a slow drag while pinching does not count either.
    let touchX = 0;
    let touchY = 0;
    let touchAt = 0;

    box.addEventListener(
      'touchstart',
      (event) => {
        swallowClick = false;
        if (event.touches.length !== 1) return;
        touchX = event.touches[0].clientX;
        touchY = event.touches[0].clientY;
        touchAt = Date.now();
      },
      { passive: true }
    );

    box.addEventListener(
      'touchend',
      (event) => {
        if (!touchAt || event.changedTouches.length !== 1) return;
        const dx = event.changedTouches[0].clientX - touchX;
        const dy = event.changedTouches[0].clientY - touchY;
        const elapsed = Date.now() - touchAt;
        touchAt = 0;

        if (Math.abs(dx) < 45 || Math.abs(dx) <= Math.abs(dy) || elapsed > 700) return;
        swallowClick = true;
        // Swipe left to advance, matching the direction the photographs move.
        show(current + (dx < 0 ? 1 : -1));
      },
      { passive: true }
    );

    document.addEventListener('keydown', (event) => {
      if (box.hidden) return;
      if (event.key === 'Escape') close();
      if (event.key === 'ArrowRight') show(current + 1);
      if (event.key === 'ArrowLeft') show(current - 1);
    });
  }
</script>
