---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import HomeHero from '../../components/HomeHero.astro';
import StatBand from '../../components/StatBand.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Reveal from '../../components/Reveal.astro';
import CallToAction from '../../components/CallToAction.astro';

import { img } from '../../data/images';
import { localePaths, t, href } from '../../i18n';
import type { Locale } from '../../i18n';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const d = t(locale);

/**
 * About, Capabilities, Industries and Facility used to be pages of their own.
 * They are sections of this one now, and the four `id`s below are what the nav
 * and the footer point at — renaming one breaks those links silently, since
 * nothing resolves an anchor at build time.
 *
 * Two of the old page heroes survive as the heading that opens their area,
 * which is why that copy still lives under `aboutPage` and `industriesPage`.
 * Capabilities and Facility have no heading of their own any more, so their
 * anchors hang on the first section of each — the list of processes and the
 * equipment table.
 */
---

<Base
  locale={locale}
  title={d.home.title}
  description={d.site.description}
  transparentHeader
>
  <HomeHero locale={locale} />
  <StatBand locale={locale} />

  <!-- ── Intro ─────────────────────────────────────────────────────────── -->
  <section id="about" class="shell scroll-mt-24 py-24 lg:py-36">
    <div class="grid gap-14 lg:grid-cols-12 lg:items-center lg:gap-20">
      <div class="lg:col-span-5">
        <Reveal>
          <p class="eyebrow">{d.home.whoEyebrow}</p>
        </Reveal>
        <Reveal delay={80}>
          <h2 class="mt-4 text-[1.75rem] leading-[1.12] sm:text-[2.125rem] lg:text-[2.625rem] lg:leading-[1.1]">
            {d.home.whoTitle}
          </h2>
        </Reveal>

        <!-- Anchors the short column so the section does not read as a hole
             next to the body copy. -->
        <Reveal delay={220} class="mt-10 hidden lg:block">
          <div class="overflow-hidden rounded-2xl">
            <Image
              src={img('operator-console')}
              alt={d.home.heroAlt}
              widths={[400, 700, 1000]}
              sizes="40vw"
              loading="lazy"
              class="aspect-4/3 w-full object-cover"
            />
          </div>
        </Reveal>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <Reveal delay={120}>
          <p class="lede">{d.home.whoBody1}</p>
        </Reveal>
        <Reveal delay={200}>
          <p class="mt-6 leading-relaxed text-steel-300">{d.home.whoBody2}</p>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ══ INDUSTRIES ══════════════════════════════════════════════════════ -->
  {/* Heading and the four groups are one band: the heading introduces the
      first sector rather than sitting in a strip of its own. The dividing
      rules stay between the sectors, so nothing separates it from group 01. */}
  <div id="industries" class="scroll-mt-24 border-t border-line/8 bg-ink-900">
    <div class="shell pt-24 lg:pt-32">
      <SectionHeading
        eyebrow={d.industriesPage.eyebrow}
        title={d.industriesPage.heroTitle}
      />
    </div>

    <div class="divide-y divide-line/8">
      {
      d.content.industries.map((industry, i) => (
        <section id={industry.id} class="scroll-mt-24 py-20 lg:py-28">
          <div class="shell grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
            <Reveal
              class:list={[
                'relative overflow-hidden rounded-2xl lg:col-span-7',
                i % 2 === 1 && 'lg:order-2 lg:col-start-6',
              ]}
            >
              <Image
                src={img(industry.image)}
                alt={industry.title}
                widths={[600, 1000, 1500]}
                sizes="(min-width:1024px) 56vw, 92vw"
                loading="lazy"
                class="aspect-16/10 w-full object-cover"
              />
            </Reveal>

            <div
              class:list={[
                'lg:col-span-5',
                i % 2 === 1 ? 'lg:order-1 lg:col-start-1' : 'lg:col-start-8',
              ]}
            >
              <Reveal>
                {/* Alternating accent, so the eye can tell one sector from the
                    next at a glance: 01 and 03 cyan, 02 and 04 orange. */}
                <p class:list={[i % 2 === 0 ? 'eyebrow-arc' : 'eyebrow']}>
                  {String(i + 1).padStart(2, '0')} — {d.common.sector}
                </p>
              </Reveal>
              <Reveal delay={80}>
                <h3 class="mt-4 text-3xl leading-[1.1] sm:text-4xl">
                  {industry.title}
                </h3>
              </Reveal>
              {/* No summary line: every group now leads straight into its
                  bullets, which is where the substance is. */}
              <Reveal delay={200}>
                <ul class="mt-8 space-y-px overflow-hidden rounded-xl border border-line/8">
                  {industry.bullets.map((bullet) => (
                    <li class="bg-line/2 px-5 py-3.5 text-sm text-steel-200">
                      {bullet}
                    </li>
                  ))}
                </ul>
              </Reveal>
            </div>
          </div>
        </section>
      ))
      }
    </div>
  </div>

  <!-- ── People ────────────────────────────────────────────────────────── -->
  <section class="border-t border-line/8 py-24 lg:py-32">
    <div class="shell grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <Reveal class="overflow-hidden rounded-2xl">
        <Image
          src={img('team-workshop')}
          alt={d.aboutPage.peopleAlt}
          widths={[600, 900, 1400]}
          sizes="(min-width:1024px) 46vw, 92vw"
          loading="lazy"
          class="aspect-4/3 w-full object-cover"
        />
      </Reveal>

      <div>
        <SectionHeading
          eyebrow={d.aboutPage.peopleEyebrow}
          title={d.aboutPage.peopleTitle}
        />
      </div>
    </div>
  </section>

  <!-- ── Renewable energy ──────────────────────────────────────────────── -->
  <section class="border-t border-line/8 bg-ink-900 py-24 lg:py-32">
    <div class="shell">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <SectionHeading
            eyebrow={d.home.energyEyebrow}
            title={d.home.energyTitle}
            lede={d.home.energyLede}
          />
          <Reveal delay={240}>
            <p class="mt-6 max-w-xl leading-relaxed text-steel-400">
              {d.home.energyBody}
            </p>
          </Reveal>

          <Reveal delay={320}>
            {/* Column count follows the data: a figure removed from the
                dictionary must not leave a blank cell in the row. */}
            <dl
              class:list={[
                'mt-10 grid gap-px overflow-hidden rounded-2xl border border-line/8 bg-line/8',
                d.home.energyFigures.length === 3 ? 'grid-cols-3' : 'grid-cols-2',
              ]}
            >
              {
                d.home.energyFigures.map((figure) => (
                  <div class="flex flex-col bg-ink-900 p-5 sm:p-6">
                    <dt class="font-display text-lg font-bold text-heading tabular-nums sm:text-xl">
                      {figure.value}
                    </dt>
                    <dd class="mt-1 text-xs leading-relaxed text-steel-400">
                      {figure.label}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </Reveal>
        </div>

        <!-- One wide shot carries the story; the two below it give scale. -->
        <div class="grid gap-4 lg:col-span-6 lg:col-start-7">
          <Reveal delay={120} class="overflow-hidden rounded-2xl">
            <Image
              src={img(d.home.energyImages[0].slug)}
              alt={d.home.energyImages[0].alt}
              widths={[600, 900, 1400, 1800]}
              sizes="(min-width:1024px) 46vw, 92vw"
              loading="lazy"
              class="aspect-16/10 w-full object-cover"
            />
          </Reveal>

          <div class="grid grid-cols-2 gap-4">
            {
              d.home.energyImages.slice(1).map((shot, i) => (
                <Reveal delay={200 + i * 90} class="overflow-hidden rounded-2xl">
                  <Image
                    src={img(shot.slug)}
                    alt={shot.alt}
                    widths={[400, 700, 1000]}
                    sizes="(min-width:1024px) 23vw, 46vw"
                    loading="lazy"
                    class="aspect-4/3 w-full object-cover"
                  />
                </Reveal>
              ))
            }
          </div>
        </div>
      </div>

      {/* The panels are one piece of a wider spend; this block is the rest of
          it. Photographs sit left of the midpoint and the text right, the
          mirror of the solar block above. */}
      <div class="mt-16 grid gap-12 lg:mt-24 lg:grid-cols-12 lg:items-center lg:gap-16">
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:col-span-6">
          {
            d.home.investmentImages.map((shot, i) => (
              <Reveal delay={160 + i * 70} class="overflow-hidden rounded-2xl">
                <Image
                  src={img(shot.slug)}
                  alt={shot.alt}
                  widths={[300, 500, 800]}
                  sizes="(min-width:1024px) 16vw, (min-width:640px) 30vw, 46vw"
                  loading="lazy"
                  class="aspect-4/3 w-full object-cover"
                />
              </Reveal>
            ))
          }
        </div>

        <div class="lg:col-span-5 lg:col-start-8">
          <Reveal>
            <h3 class="text-2xl leading-[1.15] sm:text-[1.75rem]">
              {d.home.investmentTitle}
            </h3>
          </Reveal>
          <Reveal delay={80}>
            <p class="mt-5 leading-relaxed text-steel-300">
              {d.home.investmentNote}
            </p>
          </Reveal>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Certification ─────────────────────────────────────────────────── -->
  <section class="border-t border-line/8 py-24 lg:py-28">
    <div class="shell">
      <SectionHeading
        eyebrow={d.aboutPage.certEyebrow}
        title={d.aboutPage.certTitle}
        align="center"
      />
      <div class="mx-auto mt-14 grid max-w-6xl gap-px overflow-hidden rounded-2xl border border-line/8 bg-line/8 sm:grid-cols-2 lg:grid-cols-5">
        {
          d.content.certifications.map((cert, i) => (
            <Reveal
              delay={i * 80}
              class="flex flex-col items-center gap-3 bg-ink-950 p-6 text-center lg:p-7"
            >
              <span class="font-display text-base font-bold text-heading">
                {cert.code}
              </span>
              <span class="text-xs leading-relaxed text-steel-400">
                {cert.label}
              </span>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <CallToAction
    locale={locale}
    title={d.aboutPage.ctaTitle}
    body={d.aboutPage.ctaBody}
    cta={d.common.contactForm}
    image="welder-beam"
  />
</Base>
