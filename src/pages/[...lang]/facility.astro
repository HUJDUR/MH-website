---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Reveal from '../../components/Reveal.astro';
import CallToAction from '../../components/CallToAction.astro';
import AmbientVideo from '../../components/AmbientVideo.astro';

import { img } from '../../data/images';
import { localePaths, t, href, localeMeta } from '../../i18n';
import type { Locale } from '../../i18n';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
const L = (path: string) => href(locale, path);

/**
 * Masonry rhythm for the shop-floor gallery. Layout, not copy — it stays here
 * and is zipped with the translated slugs and alt text by index.
 */
const galleryLayout = [
  { span: 'lg:col-span-7', ratio: 'aspect-16/10' },
  { span: 'lg:col-span-5', ratio: 'aspect-16/10' },
  { span: 'lg:col-span-5', ratio: 'aspect-4/3' },
  { span: 'lg:col-span-7', ratio: 'aspect-4/3' },
  { span: 'lg:col-span-4', ratio: 'aspect-square' },
  { span: 'lg:col-span-4', ratio: 'aspect-square' },
  { span: 'lg:col-span-4', ratio: 'aspect-square' },
];

---

<Base
  locale={locale}
  title={d.facilityPage.title}
  description={d.facilityPage.description}
  transparentHeader
>
  <PageHero
    eyebrow={d.facilityPage.eyebrow}
    title={d.facilityPage.heroTitle}
    lede={d.facilityPage.heroLede}
    image="workshop-hall"
    imageAlt={d.facilityPage.heroAlt}
  />

  <!-- ── Aerial ────────────────────────────────────────────────────────── -->
  <section class="shell py-20 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading
          eyebrow={d.facilityPage.worksEyebrow}
          title={d.facilityPage.worksTitle}
          lede={d.facilityPage.worksLede}
        />
        <Reveal delay={240}>
          <dl class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line/8 bg-line/8">
            {
              d.facilityPage.figures.map(({ value, label }) => (
                <div class="bg-ink-950 p-6">
                  <dt class="font-display text-2xl font-bold text-heading tabular-nums">
                    {value}
                  </dt>
                  <dd class="mt-1 text-xs text-steel-400">{label}</dd>
                </div>
              ))
            }
          </dl>
        </Reveal>
      </div>

      <Reveal delay={120} class="lg:col-span-7">
        <div class="overflow-hidden rounded-2xl">
          <Image
            src={img('facility-aerial-2')}
            alt={d.facilityPage.worksAlt}
            widths={[700, 1100, 1600, 2200]}
            sizes="(min-width:1024px) 56vw, 92vw"
            loading="eager"
            class="aspect-4/3 w-full object-cover lg:aspect-auto lg:h-full"
          />
        </div>
      </Reveal>
    </div>
  </section>

  <!-- ── Equipment ─────────────────────────────────────────────────────── -->
  <section class="border-y border-line/8 bg-ink-900 py-24 lg:py-32">
    <div class="shell">
      <SectionHeading
        eyebrow={d.facilityPage.equipmentEyebrow}
        title={d.facilityPage.equipmentTitle}
        lede={d.facilityPage.equipmentLede}
      />

      <div class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-line/8 bg-line/8 md:grid-cols-2 lg:mt-20 lg:grid-cols-4">
        {
          d.content.equipment.map((group, i) => (
            <Reveal delay={i * 90} class="bg-ink-900 p-8">
              <h3 class="font-display text-xs font-semibold uppercase tracking-[0.18em] text-flame-500">
                {group.group}
              </h3>
              <ul class="mt-6 space-y-4">
                {group.items.map((item) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-steel-200">
                    <span
                      class="mt-2 h-1 w-1 shrink-0 rounded-full bg-steel-400"
                      aria-hidden="true"
                    />
                    {item}
                  </li>
                ))}
              </ul>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Machines ──────────────────────────────────────────────────────── -->
  <section class="shell py-24 lg:py-32">
    <SectionHeading
      eyebrow={d.facilityPage.machinesEyebrow}
      title={d.facilityPage.machinesTitle}
      lede={d.facilityPage.machinesLede}
    />

    <div class="mt-14 grid gap-5 lg:mt-16 lg:grid-cols-2">
      {
        d.content.machines.map((machine, i) => {
          // An odd count would leave a hole; the last one runs wide instead.
          const wide = i === d.content.machines.length - 1 && d.content.machines.length % 2 === 1;
          return (
            <Reveal
              delay={(i % 2) * 90}
              class={`group overflow-hidden rounded-2xl border border-line/8 bg-ink-900 ${
                wide ? 'lg:col-span-2 lg:flex lg:items-stretch' : ''
              }`}
            >
              <div class={wide ? 'lg:w-1/2' : ''}>
                <Image
                  src={img(machine.image)}
                  alt={machine.imageAlt}
                  widths={[500, 800, 1200, 1600]}
                  sizes="(min-width:1024px) 46vw, 92vw"
                  loading="lazy"
                  class="aspect-16/10 w-full object-cover transition-transform duration-[1.4s] ease-[var(--ease-out-expo)] group-hover:scale-105 lg:h-full"
                />
              </div>
              <div class={`p-8 ${wide ? 'lg:flex lg:w-1/2 lg:flex-col lg:justify-center lg:p-10' : ''}`}>
                <h3 class="font-display text-xl font-bold text-heading">
                  {machine.name}
                </h3>
                {machine.spec && (
                  <p class="mt-2 font-display text-sm font-semibold text-flame-500 tabular-nums">
                    {machine.spec}
                  </p>
                )}
                <p class="mt-4 text-sm leading-relaxed text-steel-400">
                  {machine.body}
                </p>
              </div>
            </Reveal>
          );
        })
      }
    </div>
  </section>

  <!-- ── Gallery ───────────────────────────────────────────────────────── -->
  <section class="shell py-24 lg:py-32">
    <SectionHeading eyebrow={d.facilityPage.galleryEyebrow} title={d.facilityPage.galleryTitle} />

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-12">
      {
        d.facilityPage.gallery.map((shot, i) => (
          <Reveal
            delay={(i % 3) * 90}
            class={`group overflow-hidden rounded-2xl ${galleryLayout[i].span}`}
          >
            <Image
              src={img(shot.slug)}
              alt={shot.alt}
              widths={[500, 800, 1200, 1600]}
              sizes="(min-width:1024px) 40vw, (min-width:640px) 46vw, 92vw"
              loading="lazy"
              class={`w-full object-cover transition-transform duration-[1.4s] ease-[var(--ease-out-expo)] group-hover:scale-105 ${galleryLayout[i].ratio}`}
            />
          </Reveal>
        ))
      }
    </div>
  </section>

  <!-- ── Logistics ─────────────────────────────────────────────────────── -->
  <section
    data-theme="dark"
    class="relative isolate grain overflow-hidden border-t border-line/8"
  >
    <div class="absolute inset-0 -z-10">
      <Image
        src={img('bridge-transport')}
        alt=""
        widths={[800, 1400, 2000]}
        sizes="100vw"
        loading="lazy"
        class="h-full w-full object-cover opacity-30"
      />
      <div class="absolute inset-0 bg-linear-to-r from-ink-950 via-ink-950/75 to-ink-950/40"></div>
    </div>

    <div class="shell py-24 lg:py-32">
      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-6">
          <SectionHeading
            eyebrow={d.facilityPage.logisticsEyebrow}
            title={d.facilityPage.logisticsTitle}
            lede={d.facilityPage.logisticsLede}
          />
          <Reveal delay={240}>
            <p class="mt-6 max-w-xl leading-relaxed text-steel-400">{d.facilityPage.logisticsBody}</p>
          </Reveal>
        </div>

        <Reveal delay={140} class="lg:col-span-6">
          <AmbientVideo
            src1080="/video/forklifts-1080.mp4"
            src720="/video/forklifts-720.mp4"
            poster="/video/forklifts-poster.jpg"
            alt={d.facilityPage.forkliftsAlt}
            class="aspect-16/9 rounded-2xl border border-line/8"
          />
        </Reveal>
      </div>
    </div>
  </section>

  <CallToAction
    locale={locale}
    title={d.facilityPage.ctaTitle}
    body={d.facilityPage.ctaBody}
    image="team-workshop"
  />
</Base>
