---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Reveal from '../../components/Reveal.astro';
import CallToAction from '../../components/CallToAction.astro';
import { contact } from '../../data/site';

import { localePaths, t, href } from '../../i18n';
import type { Locale } from '../../i18n';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
const L = (path: string) => href(locale, path);

/**
 * Applications go through the same Web3Forms relay as the quote form — see
 * the note at the top of contact.astro. The subject is prefixed differently
 * so applications and enquiries are told apart in the inbox.
 */
const FORM_ENDPOINT = 'https://api.web3forms.com/submit';
const WEB3FORMS_KEY = '64977760-c428-4e97-af05-a8eec75b5c8e';

const fieldClass =
  'w-full rounded-xl border border-line/12 bg-ink-900 px-4 py-3.5 text-sm text-heading placeholder:text-steel-400 transition-colors duration-300 focus:border-flame-500 focus:outline-none';
const labelClass =
  'mb-2 block font-display text-xs font-semibold uppercase tracking-[0.14em] text-steel-300';
---

<Base
  locale={locale}
  title={d.careersPage.title}
  description={d.careersPage.description}
  transparentHeader
>
  <PageHero
    eyebrow={d.careersPage.eyebrow}
    title={d.careersPage.heroTitle}
    lede={d.careersPage.heroLede}
    image="team-workshop"
    imageAlt={d.careersPage.heroAlt}
  />

  <!-- ── Why work here ─────────────────────────────────────────────────── -->
  <section class="shell py-20 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading
          eyebrow={d.careersPage.introEyebrow}
          title={d.careersPage.introTitle}
        />
      </div>

      <div class="space-y-6 leading-relaxed text-steel-300 lg:col-span-6 lg:col-start-7">
        <Reveal delay={120}>
          <p class="lede">{d.careersPage.introBody1}</p>
        </Reveal>
        <Reveal delay={180}>
          <p>{d.careersPage.introBody2}</p>
        </Reveal>
      </div>
    </div>

    <div
      class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-line/8 bg-line/8 md:grid-cols-3 lg:mt-20"
    >
      {
        d.careersPage.points.map((point, i) => (
          <Reveal delay={i * 90} class="bg-ink-900 p-8">
            <h3 class="font-display text-base font-bold text-heading">
              {point.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-steel-400">
              {point.body}
            </p>
          </Reveal>
        ))
      }
    </div>
  </section>

  <!-- ── Application form ──────────────────────────────────────────────── -->
  <section class="border-t border-line/8 bg-ink-900 py-20 lg:py-28">
    <div class="shell">
      <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <Reveal>
            <h2 class="text-2xl sm:text-3xl">{d.careersPage.formTitle}</h2>
            <p class="mt-3 text-sm leading-relaxed text-steel-400">
              {d.careersPage.formNote}
            </p>
          </Reveal>

          <Reveal delay={120}>
            <form
              data-web3-form
              data-subject-field="name"
              data-endpoint={FORM_ENDPOINT}
              data-msg-sending={d.careersPage.sending}
              data-msg-success={d.careersPage.success}
              data-msg-error={d.careersPage.error}
              data-msg-subject={d.careersPage.subject}
              class="mt-10 grid gap-5 sm:grid-cols-2"
              method="post"
              action={FORM_ENDPOINT}
            >
              <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
              <input
                type="hidden"
                name="from_name"
                value="Metal Holland careers"
              />
              <input
                type="hidden"
                name="subject"
                value="Job application via metalholland.com"
              />

              <div>
                <label class={labelClass} for="name">
                  {d.careersPage.fields.name} *
                </label>
                <input
                  class={fieldClass}
                  id="name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  placeholder={d.careersPage.fields.namePlaceholder}
                />
              </div>

              <div>
                <label class={labelClass} for="email">
                  {d.careersPage.fields.email} *
                </label>
                <input
                  class={fieldClass}
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder={d.careersPage.fields.emailPlaceholder}
                />
              </div>

              <div>
                <label class={labelClass} for="phone">
                  {d.careersPage.fields.phone}
                </label>
                <input
                  class={fieldClass}
                  id="phone"
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  placeholder={d.careersPage.fields.phonePlaceholder}
                />
              </div>

              <div>
                <label class={labelClass} for="role">
                  {d.careersPage.fields.role} *
                </label>
                <div class="relative">
                  <select
                    class={`${fieldClass} appearance-none pr-10`}
                    id="role"
                    name="role"
                    required
                  >
                    <option value="">{d.careersPage.fields.rolePlaceholder}</option>
                    {
                      d.content.roles.map((role) => (
                        <option value={role}>{role}</option>
                      ))
                    }
                  </select>
                  <svg
                    viewBox="0 0 16 16"
                    fill="none"
                    aria-hidden="true"
                    class="pointer-events-none absolute right-4 top-1/2 h-3 w-3 -translate-y-1/2 text-steel-400"
                  >
                    <path
                      d="M3 6l5 5 5-5"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </div>
              </div>

              <div>
                <label class={labelClass} for="experience">
                  {d.careersPage.fields.experience}
                </label>
                <input
                  class={fieldClass}
                  id="experience"
                  name="experience"
                  type="text"
                  inputmode="numeric"
                  placeholder={d.careersPage.fields.experiencePlaceholder}
                />
              </div>

              <div>
                <label class={labelClass} for="availability">
                  {d.careersPage.fields.availability}
                </label>
                <input
                  class={fieldClass}
                  id="availability"
                  name="availability"
                  type="text"
                  placeholder={d.careersPage.fields.availabilityPlaceholder}
                />
              </div>

              <div class="sm:col-span-2">
                <label class={labelClass} for="message">
                  {d.careersPage.fields.message} *
                </label>
                <textarea
                  class={fieldClass}
                  id="message"
                  name="message"
                  rows="6"
                  required
                  placeholder={d.careersPage.fields.messagePlaceholder}></textarea>
              </div>

              <!-- Honeypot. Web3Forms rejects the submission if `botcheck`
                   comes back ticked, which only a bot would do. -->
              <input
                type="checkbox"
                name="botcheck"
                class="hidden"
                style="display:none"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
              />

              <div class="sm:col-span-2 sm:flex sm:items-center sm:gap-5">
                <button
                  type="submit"
                  class="w-full rounded-full bg-flame-500 px-7 py-4 text-sm font-semibold text-white transition-all duration-300 hover:bg-flame-400 hover:shadow-[0_0_40px_-8px] hover:shadow-flame-500/80 disabled:opacity-60 sm:w-auto"
                >
                  {d.careersPage.submit}
                </button>
                <p
                  data-form-status
                  role="status"
                  class="mt-4 text-sm text-steel-400 sm:mt-0"
                >
                </p>
                <a
                  data-form-fallback
                  hidden
                  href={`mailto:${contact.email}`}
                  class="mt-2 text-sm text-flame-500 underline-offset-4 hover:underline sm:mt-0"
                >
                  {contact.email}
                </a>
              </div>
            </form>
          </Reveal>
        </div>

        <!-- ── Aside ─────────────────────────────────────────────────── -->
        <div class="lg:col-span-4 lg:col-start-9">
          <Reveal delay={200}>
            <div class="rounded-2xl border border-line/8 bg-ink-950 p-8">
              <h2
                class="font-display text-xs font-semibold uppercase tracking-[0.18em] text-flame-500"
              >
                {d.careersPage.asideTitle}
              </h2>
              <p class="mt-4 text-sm leading-relaxed text-steel-300">
                {d.careersPage.asideBody}
              </p>

              <div class="mt-6 space-y-5">
                <div>
                  <p class="text-xs text-steel-400">
                    {d.contactPage.phoneLabel}
                  </p>
                  <a
                    href={`tel:${contact.phoneHref}`}
                    class="mt-1 block text-base text-heading transition-colors hover:text-flame-500"
                  >
                    {contact.phone}
                  </a>
                </div>
                <div>
                  <p class="text-xs text-steel-400">
                    {d.contactPage.hoursLabel}
                  </p>
                  <p class="mt-1 text-base text-heading">
                    {d.contactPage.hours}
                  </p>
                </div>
                <div>
                  <p class="text-xs text-steel-400">
                    {d.footer.officeLabel}
                  </p>
                  <address
                    class="mt-1 text-sm not-italic leading-relaxed text-steel-200"
                  >
                    {[...contact.works.lines, d.footer.country].map((line) => (
            <span class="block">{line}</span>
          ))}
                  </address>
                  <a
                    href={contact.works.mapUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-4 inline-flex items-center gap-2 text-sm text-flame-500 transition-colors hover:text-heading"
                  >
                    {d.contactPage.directions}
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </div>
            </div>
          </Reveal>
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    locale={locale}
    title={d.careersPage.ctaTitle}
    body={d.careersPage.ctaBody}
    image="welder-beam"
  />
</Base>

<script>
  import { initWeb3Forms } from '../../scripts/web3form';

  initWeb3Forms();
</script>
