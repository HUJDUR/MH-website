---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Reveal from '../../components/Reveal.astro';
import CallToAction from '../../components/CallToAction.astro';

import { img } from '../../data/images';
import { localePaths, t, href, localeMeta } from '../../i18n';
import type { Locale } from '../../i18n';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
const L = (path: string) => href(locale, path);

---

<Base
  locale={locale}
  title={d.capabilitiesPage.title}
  description={d.capabilitiesPage.description}
  transparentHeader
>
  <PageHero
    eyebrow={d.capabilitiesPage.eyebrow}
    title={d.capabilitiesPage.heroTitle}
    lede={d.capabilitiesPage.heroLede}
    image="plasma-head"
    imageAlt={d.capabilitiesPage.heroAlt}
  />

  <!-- ── Capability detail ─────────────────────────────────────────────── -->
  <div class="divide-y divide-line/8">
    {
      d.content.capabilities.map((cap, i) => (
        <section id={cap.id} class="scroll-mt-24 py-20 lg:py-28">
          <div class="shell">
            <div
              class:list={[
                'grid items-center gap-10 lg:grid-cols-2 lg:gap-20',
              ]}
            >
              <Reveal
                class:list={[
                  'overflow-hidden rounded-2xl',
                  // Alternate the image side so the page does not march.
                  i % 2 === 1 && 'lg:order-2',
                ]}
              >
                <Image
                  src={img(cap.image)}
                  alt={cap.title}
                  widths={[600, 900, 1400]}
                  sizes="(min-width:1024px) 46vw, 92vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class="aspect-4/3 h-full w-full object-cover"
                />
              </Reveal>

              <div>
                <Reveal>
                  <span class="font-display text-xs font-semibold tabular-nums tracking-[0.2em] text-flame-500">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                </Reveal>
                <Reveal delay={80}>
                  <h2 class="mt-4 text-3xl leading-[1.1] sm:text-4xl lg:text-[2.75rem]">
                    {cap.title}
                  </h2>
                </Reveal>
                <Reveal delay={140}>
                  <p class="mt-5 text-lg leading-relaxed text-steel-300">
                    {cap.summary}
                  </p>
                </Reveal>
                <Reveal delay={200}>
                  <p class="mt-4 leading-relaxed text-steel-400">{cap.detail}</p>
                </Reveal>

                <Reveal delay={260}>
                  <ul class="mt-8 grid gap-3 sm:grid-cols-2">
                    {cap.points.map((point) => (
                      <li class="flex gap-3 text-sm leading-relaxed text-steel-200">
                        <span
                          class="mt-2 h-1 w-1 shrink-0 rounded-full bg-flame-500"
                          aria-hidden="true"
                        />
                        {point}
                      </li>
                    ))}
                  </ul>
                </Reveal>
              </div>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <!-- ── Process ───────────────────────────────────────────────────────── -->
  <section class="border-t border-line/8 bg-ink-900 py-24 lg:py-32">
    <div class="shell">
      <SectionHeading
        eyebrow={d.capabilitiesPage.processEyebrow}
        title={d.capabilitiesPage.processTitle}
        lede={d.capabilitiesPage.processLede}
      />

      <ol class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-line/8 bg-line/8 lg:mt-20 lg:grid-cols-5">
        {
          d.content.processSteps.map((step, i) => (
            <Reveal
              as="li"
              delay={i * 80}
              class="flex flex-col gap-4 bg-ink-900 p-7 lg:p-8"
            >
              <span class="font-display text-sm font-bold tabular-nums text-flame-500">
                {step.step}
              </span>
              <h3 class="text-lg leading-snug">{step.title}</h3>
              <p class="text-sm leading-relaxed text-steel-400">{step.body}</p>
            </Reveal>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ── Materials ─────────────────────────────────────────────────────── -->
  <section class="shell py-24 lg:py-32">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <SectionHeading
          eyebrow={d.capabilitiesPage.materialsEyebrow}
          title={d.capabilitiesPage.materialsTitle}
          lede={d.capabilitiesPage.materialsLede}
        />
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <dl class="grid gap-px overflow-hidden rounded-2xl border border-line/8 bg-line/8 sm:grid-cols-2">
          {
            d.capabilitiesPage.materials.map(({ term, detail }, i) => (
              <Reveal delay={i * 60} class="bg-ink-950 p-6">
                <dt class="font-display text-sm font-semibold text-heading">
                  {term}
                </dt>
                <dd class="mt-2 text-sm leading-relaxed text-steel-400">
                  {detail}
                </dd>
              </Reveal>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <CallToAction
    locale={locale}
    title={d.capabilitiesPage.ctaTitle}
    body={d.capabilitiesPage.ctaBody}
    image="grinding-sparks"
  />
</Base>
