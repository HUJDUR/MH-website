---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Reveal from '../../components/Reveal.astro';
import CallToAction from '../../components/CallToAction.astro';

import { img } from '../../data/images';
import { localePaths, t, href, localeMeta } from '../../i18n';
import type { Locale } from '../../i18n';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
const L = (path: string) => href(locale, path);

---

<Base
  locale={locale}
  title={d.aboutPage.title}
  description={d.aboutPage.description}
  transparentHeader
>
  <PageHero
    eyebrow={d.aboutPage.eyebrow}
    title={d.aboutPage.heroTitle}
    lede={d.aboutPage.heroLede}
    image="operator-console"
    imageAlt={d.aboutPage.heroAlt}
    position="center 40%"
  />

  <!-- ── Story ─────────────────────────────────────────────────────────── -->
  <section class="shell py-24 lg:py-32">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <Reveal>
          <p class="eyebrow">{d.aboutPage.storyEyebrow}</p>
        </Reveal>
        <Reveal delay={80}>
          <h2 class="mt-4 text-3xl leading-[1.08] sm:text-4xl lg:text-[3rem] lg:leading-[1.05]">
            {d.aboutPage.storyTitle}
          </h2>
        </Reveal>
      </div>

      <div class="space-y-6 leading-relaxed text-steel-300 lg:col-span-6 lg:col-start-7">
        <Reveal delay={120}>
          <p class="lede">{d.aboutPage.storyLede}</p>
        </Reveal>
        <Reveal delay={180}>
          <p>{d.aboutPage.storyBody1}</p>
        </Reveal>
        <Reveal delay={240}>
          <p>{d.aboutPage.storyBody2}</p>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ── Values ────────────────────────────────────────────────────────── -->
  <section class="border-y border-line/8 bg-ink-900 py-24 lg:py-32">
    <div class="shell">
      <SectionHeading
        eyebrow={d.aboutPage.valuesEyebrow}
        title={d.aboutPage.valuesTitle}
      />

      <div class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-line/8 bg-line/8 sm:grid-cols-2 lg:mt-20">
        {
          d.content.values.map((value, i) => (
            <Reveal delay={(i % 2) * 100} class="bg-ink-900 p-8 lg:p-10">
              <span class="font-display text-xs font-semibold tabular-nums text-flame-500">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-4 text-xl leading-snug sm:text-2xl">
                {value.title}
              </h3>
              <p class="mt-4 leading-relaxed text-steel-400">{value.body}</p>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── People ────────────────────────────────────────────────────────── -->
  <section class="shell py-24 lg:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <Reveal class="overflow-hidden rounded-2xl">
        <Image
          src={img('team-workshop')}
          alt={d.aboutPage.peopleAlt}
          widths={[600, 900, 1400]}
          sizes="(min-width:1024px) 46vw, 92vw"
          loading="lazy"
          class="aspect-4/3 w-full object-cover"
        />
      </Reveal>

      <div>
        <SectionHeading
          eyebrow={d.aboutPage.peopleEyebrow}
          title={d.aboutPage.peopleTitle}
          lede={d.aboutPage.peopleLede}
        />
        <Reveal delay={240}>
          <p class="mt-6 leading-relaxed text-steel-400">{d.aboutPage.peopleBody}</p>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ── Certifications ────────────────────────────────────────────────── -->
  <section class="border-t border-line/8 bg-ink-900 py-24 lg:py-28">
    <div class="shell">
      <SectionHeading
        eyebrow={d.aboutPage.certEyebrow}
        title={d.aboutPage.certTitle}
        align="center"
      />
      <div class="mx-auto mt-14 grid max-w-6xl gap-px overflow-hidden rounded-2xl border border-line/8 bg-line/8 sm:grid-cols-2 lg:grid-cols-5">
        {
          d.content.certifications.map((cert, i) => (
            <Reveal
              delay={i * 80}
              class="flex flex-col items-center gap-3 bg-ink-900 p-6 text-center lg:p-7"
            >
              <span class="font-display text-base font-bold text-heading">
                {cert.code}
              </span>
              <span class="text-xs leading-relaxed text-steel-400">
                {cert.label}
              </span>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <CallToAction
    locale={locale}
    title={d.aboutPage.ctaTitle}
    body={d.aboutPage.ctaBody}
    image="welder-beam"
  />
</Base>
