---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Reveal from '../../components/Reveal.astro';
import CallToAction from '../../components/CallToAction.astro';

import { img } from '../../data/images';
import { localePaths, t, href, localeMeta } from '../../i18n';
import type { Locale } from '../../i18n';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
const L = (path: string) => href(locale, path);

/**
 * The "all" pill carries an empty value rather than a label, so the filter
 * script keeps working when the labels are translated.
 */
const sectors = [
  { value: '', label: d.projectsPage.all },
  ...[...new Set(d.content.projects.map((p) => p.sector))].map((sector) => ({
    value: sector,
    label: sector,
  })),
];
---

<Base
  locale={locale}
  title={d.projectsPage.title}
  description={d.projectsPage.description}
  transparentHeader
>
  <PageHero
    eyebrow={d.projectsPage.eyebrow}
    title={d.projectsPage.heroTitle}
    lede={d.projectsPage.heroLede}
    image="truss-assembly"
    imageAlt={d.projectsPage.heroAlt}
  />

  <section class="shell py-20 lg:py-28">
    <!-- Client-side filter: progressive enhancement over a plain grid, so the
         full list is present for crawlers and no-JS visitors. -->
    <Reveal>
      <div
        class="flex flex-wrap items-center gap-2 border-b border-line/8 pb-6"
        data-filter-bar
      >
        <span class="mr-2 text-[0.6875rem] uppercase tracking-[0.18em] text-steel-400">
          {d.projectsPage.filter}
        </span>
        {
          sectors.map((sector, i) => (
            <button
              type="button"
              data-filter={sector.value}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="rounded-full border border-line/12 px-4 py-2 text-sm text-steel-300 transition-colors duration-300 hover:border-line/35 hover:text-white aria-pressed:border-flame-500 aria-pressed:bg-flame-500 aria-pressed:text-white"
            >
              {sector.label}
            </button>
          ))
        }
      </div>
    </Reveal>

    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:mt-14 lg:grid-cols-3" data-project-grid>
      {
        d.content.projects.map((project, i) => (
          <Reveal
            as="article"
            delay={(i % 3) * 90}
            data-sector={project.sector}
            class="group flex flex-col overflow-hidden rounded-2xl border border-line/8 bg-ink-900 transition-colors duration-500 hover:border-line/20"
          >
            <div class="relative overflow-hidden">
              <Image
                src={img(project.image)}
                alt={project.title}
                widths={[400, 700, 1100]}
                sizes="(min-width:1024px) 30vw, (min-width:768px) 46vw, 92vw"
                loading={i < 3 ? 'eager' : 'lazy'}
                class="aspect-4/3 w-full object-cover transition-transform duration-[1.3s] ease-[var(--ease-out-expo)] group-hover:scale-106"
              />
              <span class="absolute left-4 top-4 rounded-full bg-ink-950/80 px-3 py-1.5 text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-steel-100 backdrop-blur-sm">
                {project.sector}
              </span>
            </div>

            <div class="flex flex-1 flex-col p-7">
              <h2 class="text-xl leading-snug">{project.title}</h2>
              <p class="mt-2 font-display text-xs tracking-wide text-steel-400">
                {project.meta}
              </p>
              <p class="mt-4 text-sm leading-relaxed text-steel-300">
                {project.body}
              </p>
            </div>
          </Reveal>
        ))
      }
    </div>

    <Reveal>
      <p
        data-empty
        hidden
        class="mt-14 text-center text-sm text-steel-400"
      >
        {d.projectsPage.empty}
      </p>
    </Reveal>
  </section>

  <CallToAction
    locale={locale}
    title={d.projectsPage.ctaTitle}
    body={d.projectsPage.ctaBody}
    image="steel-sections"
  />
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filter-bar]');
  const grid = document.querySelector<HTMLElement>('[data-project-grid]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  if (bar && grid) {
    const buttons = bar.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = grid.querySelectorAll<HTMLElement>('[data-sector]');

    bar.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
        '[data-filter]'
      );
      if (!button) return;

      const sector = button.dataset.filter ?? '';
      buttons.forEach((b) =>
        b.setAttribute('aria-pressed', String(b === button))
      );

      let shown = 0;
      cards.forEach((card) => {
        const match = !sector || card.dataset.sector === sector;
        card.hidden = !match;
        if (match) shown++;
      });

      if (empty) empty.hidden = shown > 0;
    });
  }
</script>
