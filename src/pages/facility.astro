---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Reveal from '../components/Reveal.astro';
import CallToAction from '../components/CallToAction.astro';
import { equipment } from '../data/content';
import { img } from '../data/images';

/** Shop-floor gallery. Aspect hints keep the masonry rhythm deliberate. */
const gallery = [
  { slug: 'cnc-gantry', alt: 'CNC gantry cutting table in the plate hall', span: 'lg:col-span-7', ratio: 'aspect-16/10' },
  { slug: 'welding-hall', alt: 'Welders working on sections in the fabrication hall', span: 'lg:col-span-5', ratio: 'aspect-16/10' },
  { slug: 'nested-plate', alt: 'Nested parts cut from a single plate', span: 'lg:col-span-5', ratio: 'aspect-4/3' },
  { slug: 'machine-hall', alt: 'Machine hall with overhead cranage', span: 'lg:col-span-7', ratio: 'aspect-4/3' },
  { slug: 'drilling-detail', alt: 'Drilling a section on the beam line', span: 'lg:col-span-4', ratio: 'aspect-square' },
  { slug: 'pipe-fabrication', alt: 'Pipe spool fabrication in progress', span: 'lg:col-span-4', ratio: 'aspect-square' },
  { slug: 'steel-sections', alt: 'Primed steel sections awaiting despatch', span: 'lg:col-span-4', ratio: 'aspect-square' },
];
---

<Base
  title="Facility & equipment"
  description="Metal Holland's production facility: covered fabrication halls, CNC cutting tables, drilling lines, rolls, welding bays, blasting and priming, and loading for abnormal transport."
  transparentHeader
>
  <PageHero
    eyebrow="Facility"
    title="The shop floor."
    lede="Four covered halls, gantry cutting, cranage in every bay and a yard sized for the sections that leave on a low-loader."
    image="workshop-hall"
    imageAlt="Interior of a Metal Holland fabrication hall"
  />

  <!-- ── Aerial ────────────────────────────────────────────────────────── -->
  <section class="shell py-20 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading
          eyebrow="The works"
          title="One site, start to finish."
          lede="Plate arrives at one end of the yard and leaves the other end as a
            coated, measured, documented section. Nothing is trucked across town
            between operations."
        />
        <Reveal delay={240}>
          <dl class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/8 bg-white/8">
            {
              [
                ['32,000 m²+', 'Site area'],
                ['[4]', 'Fabrication halls'],
                ['[XX] t', 'Max crane capacity'],
                ['13 m', 'Longest section handled'],
              ].map(([value, label]) => (
                <div class="bg-ink-950 p-6">
                  <dt class="font-display text-2xl font-bold text-white tabular-nums">
                    {value}
                  </dt>
                  <dd class="mt-1 text-xs text-steel-400">{label}</dd>
                </div>
              ))
            }
          </dl>
        </Reveal>
      </div>

      <Reveal delay={120} class="lg:col-span-7">
        <div class="overflow-hidden rounded-2xl">
          <Image
            src={img('facility-aerial-2')}
            alt="Aerial view of the Metal Holland works"
            widths={[700, 1100, 1600, 2200]}
            sizes="(min-width:1024px) 56vw, 92vw"
            loading="eager"
            class="aspect-4/3 w-full object-cover lg:aspect-auto lg:h-full"
          />
        </div>
      </Reveal>
    </div>
  </section>

  <!-- ── Equipment ─────────────────────────────────────────────────────── -->
  <section class="border-y border-white/8 bg-ink-900 py-24 lg:py-32">
    <div class="shell">
      <SectionHeading
        eyebrow="Equipment"
        title="What is on the floor."
        lede="An indicative list. Ask us about a specific size, thickness or tolerance
          and you will get a straight answer about whether it fits."
      />

      <div class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-white/8 bg-white/8 md:grid-cols-2 lg:mt-20 lg:grid-cols-4">
        {
          equipment.map((group, i) => (
            <Reveal delay={i * 90} class="bg-ink-900 p-8">
              <h3 class="font-display text-xs font-semibold uppercase tracking-[0.18em] text-flame-500">
                {group.group}
              </h3>
              <ul class="mt-6 space-y-4">
                {group.items.map((item) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-steel-200">
                    <span
                      class="mt-2 h-1 w-1 shrink-0 rounded-full bg-steel-400"
                      aria-hidden="true"
                    />
                    {item}
                  </li>
                ))}
              </ul>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Gallery ───────────────────────────────────────────────────────── -->
  <section class="shell py-24 lg:py-32">
    <SectionHeading eyebrow="Inside the halls" title="Work in progress." />

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-12">
      {
        gallery.map((shot, i) => (
          <Reveal
            delay={(i % 3) * 90}
            class={`group overflow-hidden rounded-2xl ${shot.span}`}
          >
            <Image
              src={img(shot.slug)}
              alt={shot.alt}
              widths={[500, 800, 1200, 1600]}
              sizes="(min-width:1024px) 40vw, (min-width:640px) 46vw, 92vw"
              loading="lazy"
              class={`w-full object-cover transition-transform duration-[1.4s] ease-[var(--ease-out-expo)] group-hover:scale-105 ${shot.ratio}`}
            />
          </Reveal>
        ))
      }
    </div>
  </section>

  <!-- ── Logistics ─────────────────────────────────────────────────────── -->
  <section class="relative isolate grain overflow-hidden border-t border-white/8">
    <div class="absolute inset-0 -z-10">
      <Image
        src={img('bridge-transport')}
        alt=""
        widths={[800, 1400, 2000]}
        sizes="100vw"
        loading="lazy"
        class="h-full w-full object-cover opacity-30"
      />
      <div class="absolute inset-0 bg-linear-to-r from-ink-950 via-ink-950/75 to-ink-950/40"></div>
    </div>

    <div class="shell py-24 lg:py-32">
      <div class="max-w-2xl">
        <SectionHeading
          eyebrow="Getting it to you"
          title="Sections leave whole."
          lede="We would rather solve a transport problem than split a construction
            into pieces that have to be welded again on site. Abnormal loads,
            escorts and permits are part of the job, not an afterthought."
        />
      </div>
    </div>
  </section>

  <CallToAction
    title="Come and see it."
    body="Visits are welcome. Walk the halls, meet the people who would build your work, and judge the shop for yourself."
    image="team-workshop"
  />
</Base>
