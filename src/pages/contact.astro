---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Reveal from '../components/Reveal.astro';
import { contact, site } from '../data/site';
import { industries } from '../data/content';

/**
 * The site is statically hosted, so the form needs an external handler.
 * Point this at your provider (Formspree, Netlify Forms, Basin, or your own
 * endpoint). Until it is set, the form falls back to opening a pre-filled
 * email — see the script at the bottom of this file.
 */
const FORM_ENDPOINT = '[https://formspree.io/f/your-form-id]';
const endpointConfigured = !FORM_ENDPOINT.startsWith('[');

const fieldClass =
  'w-full rounded-xl border border-white/12 bg-ink-900 px-4 py-3.5 text-sm text-white placeholder:text-steel-400 transition-colors duration-300 focus:border-flame-500 focus:outline-none';
const labelClass =
  'mb-2 block font-display text-xs font-semibold uppercase tracking-[0.14em] text-steel-300';
---

<Base
  title="Contact"
  description="Request a quote from Metal Holland — send your drawings, scope and required delivery date and we will come back with a realistic price and lead time."
  transparentHeader
>
  <PageHero
    eyebrow="Contact"
    title="Send us the drawings."
    lede="Tell us what you need built and by when. You will get a realistic price, a realistic date, and any questions the drawings raise."
    image="welding-dark"
    imageAlt="A welding arc lighting the dark of the fabrication hall"
  />

  <section class="shell py-20 lg:py-28">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
      <!-- ── Form ──────────────────────────────────────────────────────── -->
      <div class="lg:col-span-7">
        <Reveal>
          <h2 class="text-2xl sm:text-3xl">Request a quote</h2>
          <p class="mt-3 text-sm leading-relaxed text-steel-400">
            Fields marked with an asterisk are required. Drawings can follow by
            email — we will reply with an address to send them to.
          </p>
        </Reveal>

        <Reveal delay={120}>
          <form
            data-quote-form
            data-endpoint={endpointConfigured ? FORM_ENDPOINT : ''}
            data-fallback-email={contact.email}
            class="mt-10 grid gap-5 sm:grid-cols-2"
            method="post"
            action={endpointConfigured ? FORM_ENDPOINT : undefined}
          >
            <div>
              <label class={labelClass} for="name">Name *</label>
              <input
                class={fieldClass}
                id="name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Your name"
              />
            </div>

            <div>
              <label class={labelClass} for="company">Company *</label>
              <input
                class={fieldClass}
                id="company"
                name="company"
                type="text"
                required
                autocomplete="organization"
                placeholder="Company name"
              />
            </div>

            <div>
              <label class={labelClass} for="email">Email *</label>
              <input
                class={fieldClass}
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="name@company.com"
              />
            </div>

            <div>
              <label class={labelClass} for="phone">Phone</label>
              <input
                class={fieldClass}
                id="phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                placeholder="Optional"
              />
            </div>

            <div class="sm:col-span-2">
              <label class={labelClass} for="sector">Sector</label>
              <div class="relative">
                <select class={`${fieldClass} appearance-none pr-10`} id="sector" name="sector">
                  <option value="">Select a sector</option>
                  {
                    industries.map((industry) => (
                      <option value={industry.title}>{industry.title}</option>
                    ))
                  }
                  <option value="Other">Other</option>
                </select>
                <svg
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                  class="pointer-events-none absolute right-4 top-1/2 h-3 w-3 -translate-y-1/2 text-steel-400"
                >
                  <path
                    d="M3 6l5 5 5-5"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </div>
            </div>

            <div class="sm:col-span-2">
              <label class={labelClass} for="message">
                What do you need built? *
              </label>
              <textarea
                class={fieldClass}
                id="message"
                name="message"
                rows="6"
                required
                placeholder="Scope, material, approximate tonnage or quantity, and the date you need it delivered."
              ></textarea>
            </div>

            <!-- Honeypot: bots fill it, people never see it. -->
            <div class="hidden" aria-hidden="true">
              <label for="company-website">Leave this field empty</label>
              <input
                id="company-website"
                name="_gotcha"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <div class="sm:col-span-2 sm:flex sm:items-center sm:gap-5">
              <button
                type="submit"
                class="w-full rounded-full bg-flame-500 px-7 py-4 text-sm font-semibold text-white transition-all duration-300 hover:bg-flame-400 hover:shadow-[0_0_40px_-8px] hover:shadow-flame-500/80 disabled:opacity-60 sm:w-auto"
              >
                Send enquiry
              </button>
              <p
                data-form-status
                role="status"
                class="mt-4 text-sm text-steel-400 sm:mt-0"
              >
              </p>
            </div>
          </form>
        </Reveal>

        {
          !endpointConfigured && (
            <Reveal delay={180}>
              <p class="mt-6 rounded-xl border border-arc-500/30 bg-arc-500/8 px-5 py-4 text-xs leading-relaxed text-arc-400">
                <strong class="font-semibold">Setup note (remove before launch):</strong>{' '}
                no form endpoint is configured yet, so submissions open a
                pre-filled email instead. Set <code>FORM_ENDPOINT</code> at the
                top of <code>src/pages/contact.astro</code> to your form provider
                to enable real submissions.
              </p>
            </Reveal>
          )
        }
      </div>

      <!-- ── Details ───────────────────────────────────────────────────── -->
      <div class="lg:col-span-4 lg:col-start-9">
        <Reveal delay={200}>
          <div class="rounded-2xl border border-white/8 bg-ink-900 p-8">
            <h2 class="font-display text-xs font-semibold uppercase tracking-[0.18em] text-flame-500">
              Direct
            </h2>
            <div class="mt-6 space-y-5">
              <div>
                <p class="text-xs text-steel-400">Email</p>
                <a
                  href={`mailto:${contact.email}`}
                  class="mt-1 block text-base text-white transition-colors hover:text-flame-500"
                >
                  {contact.email}
                </a>
              </div>
              <div>
                <p class="text-xs text-steel-400">Phone</p>
                <a
                  href={`tel:${contact.phoneHref}`}
                  class="mt-1 block text-base text-white transition-colors hover:text-flame-500"
                >
                  {contact.phone}
                </a>
              </div>
              <div>
                <p class="text-xs text-steel-400">Opening hours</p>
                <p class="mt-1 text-base text-white">{contact.hours}</p>
              </div>
            </div>
          </div>
        </Reveal>

        <Reveal delay={280}>
          <div class="mt-5 grid gap-5">
            {
              [contact.works].map((location) => (
                <div class="rounded-2xl border border-white/8 p-8">
                  <h2 class="font-display text-xs font-semibold uppercase tracking-[0.18em] text-steel-400">
                    {location.label}
                  </h2>
                  <address class="mt-4 text-sm not-italic leading-relaxed text-steel-200">
                    {location.lines.map((line) => (
                      <span class="block">{line}</span>
                    ))}
                  </address>
                  <a
                    href={location.mapUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-4 inline-flex items-center gap-2 text-sm text-flame-500 transition-colors hover:text-white"
                  >
                    Get directions
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              ))
            }
          </div>
        </Reveal>

        <Reveal delay={360}>
          <p class="mt-6 text-xs leading-relaxed text-steel-400">
            {contact.registration.vat}
          </p>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ── Map ───────────────────────────────────────────────────────────── -->
  <section class="border-t border-white/8 bg-ink-900 py-20 lg:py-28">
    <div class="shell">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <h2 class="font-display text-xs font-semibold uppercase tracking-[0.18em] text-flame-500">
            Where to find us
          </h2>
          <p class="mt-3 text-2xl sm:text-3xl">
            {contact.works.lines[0]}, {contact.works.lines[1]}
          </p>
        </div>
        <a
          href={contact.works.mapUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm text-steel-200 transition-colors hover:text-flame-500"
        >
          Open in Google Maps
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <Reveal delay={120}>
        <!-- The iframe is injected by CookieConsent.astro once cookies are
             accepted; until then only the placeholder below is shown. -->
        <div
          data-consent-embed
          data-embed-src={contact.works.mapEmbedUrl}
          data-embed-title={`Map showing ${site.name} at ${contact.works.lines.join(', ')}`}
          data-embed-class="block h-[380px] w-full border-0 lg:h-[460px]"
          class="mt-10 overflow-hidden rounded-2xl border border-white/8 bg-ink-950"
        >
          <div
            data-embed-placeholder
            class="flex h-[380px] flex-col items-center justify-center gap-5 px-6 text-center lg:h-[460px]"
          >
            <p class="max-w-md text-sm leading-relaxed text-steel-300">
              The map is loaded from Google Maps, which sets its own cookies.
              Load it to see the works on a map, or open the pin directly in
              Google Maps instead.
            </p>
            <div class="flex flex-col gap-3 sm:flex-row">
              <button
                type="button"
                data-load-map
                class="rounded-full bg-flame-500 px-6 py-3 text-sm font-semibold text-white transition-all duration-300 hover:bg-flame-400 hover:shadow-[0_0_40px_-8px] hover:shadow-flame-500/80"
              >
                Load map
              </button>
              <a
                href={contact.works.mapUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-white/15 px-6 py-3 text-sm font-semibold text-white transition-colors duration-300 hover:border-white/40"
              >
                Open in Google Maps
              </a>
            </div>
          </div>
        </div>
      </Reveal>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-quote-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  if (form) {
    const setStatus = (text: string, tone: 'ok' | 'error' | 'idle' = 'idle') => {
      if (!status) return;
      status.textContent = text;
      status.className =
        'mt-4 text-sm sm:mt-0 ' +
        (tone === 'ok'
          ? 'text-arc-400'
          : tone === 'error'
            ? 'text-flame-400'
            : 'text-steel-400');
    };

    form.addEventListener('submit', async (event) => {
      const data = new FormData(form);
      const endpoint = form.dataset.endpoint;

      // No endpoint configured yet: hand the enquiry to the user's mail client
      // so the form is never a dead end during setup.
      if (!endpoint) {
        event.preventDefault();
        const body = [
          `Name: ${data.get('name')}`,
          `Company: ${data.get('company')}`,
          `Email: ${data.get('email')}`,
          `Phone: ${data.get('phone') || '-'}`,
          `Sector: ${data.get('sector') || '-'}`,
          '',
          String(data.get('message') ?? ''),
        ].join('\n');

        window.location.href =
          `mailto:${form.dataset.fallbackEmail}` +
          `?subject=${encodeURIComponent('Quote request — ' + data.get('company'))}` +
          `&body=${encodeURIComponent(body)}`;
        setStatus('Opening your email client…');
        return;
      }

      event.preventDefault();
      const button = form.querySelector('button[type="submit"]');
      button?.setAttribute('disabled', 'true');
      setStatus('Sending…');

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        setStatus('Thank you — we will come back to you shortly.', 'ok');
      } catch {
        setStatus(
          'Something went wrong. Please email us directly instead.',
          'error'
        );
      } finally {
        button?.removeAttribute('disabled');
      }
    });
  }
</script>

<script>
  // "Load map" doubles as a consent grant — the map is the only thing on the
  // site that sets third-party cookies.
  document
    .querySelector<HTMLButtonElement>('[data-load-map]')
    ?.addEventListener('click', () => window.mhCookieConsent?.set('all'));
</script>
