---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Reveal from '../components/Reveal.astro';
import CallToAction from '../components/CallToAction.astro';
import { projects } from '../data/content';
import { img } from '../data/images';

const sectors = ['All', ...new Set(projects.map((p) => p.sector))];
---

<Base
  title="Projects"
  description="Selected fabrication work by Metal Holland — bridge sections, hull sections, pipe spools, welded girders and serial machine frames."
  transparentHeader
>
  <PageHero
    eyebrow="Projects"
    title="Selected work."
    lede="A cross-section of what leaves the yard. Client names and figures are shared on request where confidentiality allows."
    image="truss-assembly"
    imageAlt="A welded truss assembly on trestles in the fabrication hall"
  />

  <section class="shell py-20 lg:py-28">
    <!-- Client-side filter: progressive enhancement over a plain grid, so the
         full list is present for crawlers and no-JS visitors. -->
    <Reveal>
      <div
        class="flex flex-wrap items-center gap-2 border-b border-white/8 pb-6"
        data-filter-bar
      >
        <span class="mr-2 text-[0.6875rem] uppercase tracking-[0.18em] text-steel-400">
          Filter
        </span>
        {
          sectors.map((sector, i) => (
            <button
              type="button"
              data-filter={sector}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="rounded-full border border-white/12 px-4 py-2 text-sm text-steel-300 transition-colors duration-300 hover:border-white/35 hover:text-white aria-pressed:border-flame-500 aria-pressed:bg-flame-500 aria-pressed:text-white"
            >
              {sector}
            </button>
          ))
        }
      </div>
    </Reveal>

    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:mt-14 lg:grid-cols-3" data-project-grid>
      {
        projects.map((project, i) => (
          <Reveal
            as="article"
            delay={(i % 3) * 90}
            data-sector={project.sector}
            class="group flex flex-col overflow-hidden rounded-2xl border border-white/8 bg-ink-900 transition-colors duration-500 hover:border-white/20"
          >
            <div class="relative overflow-hidden">
              <Image
                src={img(project.image)}
                alt={project.title}
                widths={[400, 700, 1100]}
                sizes="(min-width:1024px) 30vw, (min-width:768px) 46vw, 92vw"
                loading={i < 3 ? 'eager' : 'lazy'}
                class="aspect-4/3 w-full object-cover transition-transform duration-[1.3s] ease-[var(--ease-out-expo)] group-hover:scale-106"
              />
              <span class="absolute left-4 top-4 rounded-full bg-ink-950/80 px-3 py-1.5 text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-steel-100 backdrop-blur-sm">
                {project.sector}
              </span>
            </div>

            <div class="flex flex-1 flex-col p-7">
              <h2 class="text-xl leading-snug">{project.title}</h2>
              <p class="mt-2 font-display text-xs tracking-wide text-steel-400">
                {project.meta}
              </p>
              <p class="mt-4 text-sm leading-relaxed text-steel-300">
                {project.body}
              </p>
            </div>
          </Reveal>
        ))
      }
    </div>

    <Reveal>
      <p
        data-empty
        hidden
        class="mt-14 text-center text-sm text-steel-400"
      >
        No projects listed in this sector yet.
      </p>
    </Reveal>
  </section>

  <CallToAction
    title="References for your sector."
    body="Ask and we will put you in touch with clients doing work like yours — the most useful reference is always the one that matches your own drawings."
    image="steel-sections"
  />
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filter-bar]');
  const grid = document.querySelector<HTMLElement>('[data-project-grid]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  if (bar && grid) {
    const buttons = bar.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = grid.querySelectorAll<HTMLElement>('[data-sector]');

    bar.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
        '[data-filter]'
      );
      if (!button) return;

      const sector = button.dataset.filter!;
      buttons.forEach((b) =>
        b.setAttribute('aria-pressed', String(b === button))
      );

      let shown = 0;
      cards.forEach((card) => {
        const match = sector === 'All' || card.dataset.sector === sector;
        card.hidden = !match;
        if (match) shown++;
      });

      if (empty) empty.hidden = shown > 0;
    });
  }
</script>
