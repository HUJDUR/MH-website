---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { img } from '../data/images';
import { t, href, defaultLocale } from '../i18n';

// The 404 answers for any unmatched path, so it uses the default language;
// the header's language switcher still takes the visitor anywhere.
//
// English-only is the settled choice (2026-09-16), not a gap: a static host
// serves one /404.html for everything, so /bs/ and /nl/ misses land here too.
// `notFound` in bs.ts and nl.ts is therefore unreachable copy — see the note
// above those blocks. Localising this would mean emitting a 404 per locale
// directory and relying on the host to pick the nearest one.
const locale = defaultLocale;
const d = t(locale);
---

<Base
  locale={locale}
  title={d.notFound.title}
  description={d.notFound.description}
>
  <section
    data-theme="dark"
    class="relative isolate grain flex min-h-[80svh] items-center overflow-hidden"
  >
    <div class="absolute inset-0 -z-10">
      <Image
        src={img('grinding-sparks')}
        alt=""
        widths={[800, 1400, 2000]}
        sizes="100vw"
        loading="eager"
        class="h-full w-full object-cover opacity-25"
      />
      <div class="absolute inset-0 bg-linear-to-t from-ink-950 via-ink-950/80 to-ink-950/60"></div>
    </div>

    <div class="shell py-32">
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-5 max-w-3xl text-4xl leading-[1.05] sm:text-6xl lg:text-7xl">
        {d.notFound.heading}
      </h1>
      <p class="lede mt-7 max-w-xl">
        {d.notFound.body}
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        <Button href={href(locale, '/')}>{d.common.backToHome}</Button>
        <Button href={href(locale, '/contact')} variant="outline">
          {d.common.contactUs}
        </Button>
      </div>

      <nav class="mt-14 flex flex-wrap gap-x-7 gap-y-3" aria-label={d.nav.siteSections}>
        {
          d.nav.items.map((item) => (
            <a
              href={href(locale, item.href)}
              class="text-sm text-steel-400 underline decoration-line/20 underline-offset-4 transition-colors hover:text-heading"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </section>
</Base>
