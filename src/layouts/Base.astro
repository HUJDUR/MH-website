---
import '../styles/global.css';

/**
 * Preloaded by hand. Reached only through the stylesheet, these files are not
 * discovered until the CSS has parsed — late enough that a navigation paints a
 * frame or two in the fallback face and then reflows when the real one swaps
 * in, which reads as the text twitching into position. Preloading starts the
 * fetch alongside the HTML instead, so the face is normally ready by first
 * paint. `?url` returns the same hashed asset the CSS points at, so this costs
 * no extra request.
 *
 * Latin covers the bulk of every locale. Bosnian also needs latin-ext for
 * č/ć/đ/š/ž throughout, so it pays for those two as well; English and Dutch
 * only meet that subset in "Šamac" and can afford to swap it in late.
 */
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import archivoLatinExt from '@fontsource-variable/archivo/files/archivo-latin-ext-wght-normal.woff2?url';
import interLatinExt from '@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import PageLoader from '../components/PageLoader.astro';
import { site, contact } from '../data/site';
import {
  locales,
  localeMeta,
  defaultLocale,
  href,
  canonicalPath,
  asset,
  t,
  type Locale,
} from '../i18n';

interface Props {
  /** Which language this page is rendered in. */
  locale: Locale;
  title: string;
  description?: string;
  /** Absolute or root-relative path to the social share image. */
  ogImage?: string;
  /** Header starts transparent over a full-bleed hero. */
  transparentHeader?: boolean;
}

const {
  locale = defaultLocale,
  title,
  description,
  ogImage = '/video/facility-poster.jpg',
  transparentHeader = false,
} = Astro.props;

const d = t(locale);
const meta = localeMeta[locale];

const preloadedFonts = [
  archivoLatin,
  interLatin,
  ...(locale === 'bs' ? [archivoLatinExt, interLatinExt] : []),
];
const pageTitle = `${title} | ${site.shortName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

/**
 * Staging must never be indexed: a second copy of the same copy competes with
 * the real site and can outrank it. Derived from `site` in astro.config.mjs
 * rather than hardcoded, because a `noindex` left behind on the production
 * build is the more expensive mistake of the two — change `site` to the live
 * host and this switches itself off. Anything that is not the production
 * hostname counts as staging, so a preview URL is covered too.
 */
const isStaging =
  (Astro.site?.hostname ?? new URL(site.url).hostname) !== 'www.metalholland.com';
const ogImageUrl = new URL(asset(ogImage), Astro.site ?? site.url).href;

/** The same page in every language, for hreflang. */
const here = canonicalPath(Astro.url.pathname);
const alternates = locales.map((code) => ({
  code,
  hreflang: localeMeta[code].hreflang,
  url: new URL(href(code, here), Astro.site ?? site.url).href,
}));

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  description: d.site.description,
  logo: new URL(asset('/logo/metal-holland-color.svg'), Astro.site ?? site.url).href,
  email: contact.email,
  telephone: contact.phone,
  vatID: '401899980009',
  taxID: '4401899980009',
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.works.lines[0],
    postalCode: '76230',
    addressLocality: 'Šamac',
    addressCountry: 'BA',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 45.05029,
    longitude: 18.4777441,
  },
  hasMap: contact.works.mapUrl,
};
---

<!doctype html>
<html lang={meta.htmlLang} data-theme="dark" class="scroll-pt-24">
  <head>
    <meta charset="utf-8" />
    <!-- Blocking on purpose: this has to settle the theme before the first
         paint, or a returning light-mode visitor gets a black flash. -->
    <script is:inline>
      try {
        if (localStorage.getItem('mh-theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
        }
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {
      preloadedFonts.map((url) => (
        <link rel="preload" as="font" type="font/woff2" href={url} crossorigin />
      ))
    }

    <title>{pageTitle}</title>
    <meta name="description" content={description ?? d.site.description} />
    <link rel="canonical" href={canonical} />
    {isStaging && <meta name="robots" content="noindex, nofollow" />}

    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.url} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(href(defaultLocale, here), Astro.site ?? site.url).href}
    />

    <link rel="icon" type="image/svg+xml" href={asset("/logo/mh-mark-color.svg")} />
    <meta name="theme-color" content="#06090c" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description ?? d.site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={meta.hreflang.replace('-', '_')} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />

    <!-- Reveal animations only apply when scripting is on, so no-JS visitors
         are never left with permanently hidden content.

         The loader flag is settled here rather than in the component, for the
         same reason the theme is: this is a multi-page site, so a second page
         is a second full document, and the curtain has to be decided before
         the first paint or it flashes on every click. The flag is written the
         moment it is read, not when the loader finishes, so navigating away
         mid-load does not earn a second curtain. `sessionStorage` clears with
         the tab, which is the definition of "once per visit" we want. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (sessionStorage.getItem('mh-loader-seen')) {
          document.documentElement.classList.add('mh-loader-seen');
        } else {
          sessionStorage.setItem('mh-loader-seen', '1');
        }
      } catch {}
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
  </head>

  <body>
    <PageLoader />

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-100 focus:rounded-full focus:bg-flame-500 focus:px-5 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-white"
    >
      {d.nav.skipToContent}
    </a>

    <Header transparent={transparentHeader} locale={locale} />

    <main id="main">
      <slot />
    </main>

    <Footer locale={locale} />

    <CookieConsent locale={locale} />

    <script>
      // --- Scroll reveal -------------------------------------------------
      const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      if (prefersReducedMotion || !('IntersectionObserver' in window)) {
        revealables.forEach((el) => el.setAttribute('data-reveal', 'is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.setAttribute('data-reveal', 'is-visible');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
        );
        revealables.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
