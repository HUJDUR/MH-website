---
import { locales, localeMeta, href, canonicalPath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Canonical path of the current page, without any locale prefix. */
  path: string;
}

const { locale, path } = Astro.props;
const current = localeMeta[locale];
const here = canonicalPath(path);
---

<!-- <details> so the menu opens without JavaScript; the script below only adds
     the niceties (close on outside click or Escape). -->
<details class="group relative" data-language-switcher>
  <summary
    class="flex h-9 cursor-pointer list-none items-center gap-1.5 rounded-full border border-line/12 px-3 text-xs font-semibold text-steel-300 transition-colors duration-300 hover:border-line/30 hover:text-heading [&::-webkit-details-marker]:hidden"
    aria-label={current.label}
  >
    <span class="font-display tracking-[0.08em]">{current.short}</span>
    <svg
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
      class="h-2.5 w-2.5 transition-transform duration-300 group-open:rotate-180"
    >
      <path
        d="M3 6l5 5 5-5"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </summary>

  <div
    class="absolute right-0 top-full z-50 mt-2 min-w-44 overflow-hidden rounded-xl border border-line/10 bg-ink-850 py-1.5 shadow-[var(--mh-shadow-pop)]"
  >
    {
      locales.map((code) => (
        <a
          href={href(code, here)}
          hreflang={localeMeta[code].hreflang}
          lang={localeMeta[code].htmlLang}
          aria-current={code === locale ? 'true' : undefined}
          class:list={[
            'flex items-center justify-between gap-6 px-4 py-2.5 text-sm transition-colors duration-200',
            code === locale
              ? 'text-flame-500'
              : 'text-steel-300 hover:bg-line/5 hover:text-heading',
          ]}
        >
          {localeMeta[code].label}
          <span class="font-display text-[0.625rem] tracking-[0.08em] text-steel-400">
            {localeMeta[code].short}
          </span>
        </a>
      ))
    }
  </div>
</details>

<script>
  const switchers =
    document.querySelectorAll<HTMLDetailsElement>('[data-language-switcher]');

  if (switchers.length) {
    const closeAll = (except?: HTMLDetailsElement) =>
      switchers.forEach((el) => {
        if (el !== except) el.open = false;
      });

    document.addEventListener('click', (event) => {
      const inside = (event.target as HTMLElement).closest(
        '[data-language-switcher]'
      ) as HTMLDetailsElement | null;
      closeAll(inside ?? undefined);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeAll();
    });

    // Remember the reader's choice so a later visit to the root can offer it.
    switchers.forEach((el) =>
      el.querySelectorAll('a[lang]').forEach((link) =>
        link.addEventListener('click', () => {
          try {
            localStorage.setItem('mh-lang', link.getAttribute('lang') ?? 'en');
          } catch {
            /* Blocked storage — the choice just will not be remembered. */
          }
        })
      )
    );
  }
</script>
