---
interface Props {
  /** Stagger, in milliseconds, applied to this element's transition. */
  delay?: number;
  /** Rendered element. Use a semantic tag where one applies. */
  as?: string;
  class?: string;
  /** Anything else — `data-theme`, `id`, `aria-*` — lands on the element. */
  [key: string]: unknown;
}

const {
  delay = 0,
  as: Tag = 'div',
  class: className = '',
  ...rest
} = Astro.props;
---

<Tag
  data-reveal
  style={delay ? `--reveal-delay:${delay}ms` : undefined}
  class={className}
  {...rest}
>
  <slot />
</Tag>
