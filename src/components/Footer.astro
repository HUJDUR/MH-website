---
import Logo from './Logo.astro';
import { contact, site } from '../data/site';
import { t, href, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-line/8 bg-ink-900">
  <div
    class="pointer-events-none absolute -right-40 -top-40 h-[32rem] w-[32rem] rounded-full bg-flame-500/8 blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <div class="shell relative py-16 lg:py-24">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3 lg:gap-16">
      <div>
        <Logo width={220} height={37} class="h-7 w-auto" />

        <div class="mt-8 flex flex-col gap-2 text-sm">
          <a
            href={`mailto:${contact.email}`}
            class="w-fit text-heading transition-colors hover:text-flame-500"
          >
            {contact.email}
          </a>
          <a
            href={`tel:${contact.phoneHref}`}
            class="w-fit text-heading transition-colors hover:text-flame-500"
          >
            {contact.phone}
          </a>
        </div>
      </div>

      <div>
        <h2
          class="font-display text-[0.6875rem] font-semibold uppercase tracking-[0.18em] text-steel-400"
        >
          {d.footer.officeLabel}
        </h2>
        <address class="mt-4 text-sm not-italic leading-relaxed text-steel-300">
          {[...contact.works.lines, d.footer.country].map((line) => (
            <span class="block">{line}</span>
          ))}
        </address>
      </div>

      <div>
        <h2
          class="font-display text-[0.6875rem] font-semibold uppercase tracking-[0.18em] text-steel-400"
        >
          {d.contactPage.hoursLabel}
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-steel-300">
          {d.contactPage.hours}
        </p>
        <a
          href={contact.works.mapUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 text-sm text-flame-500 transition-colors hover:text-heading"
        >
          {d.contactPage.directions}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-line/8 pt-8 text-xs text-steel-400 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {site.name}. {d.footer.rights}</p>
      <p class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <span>{d.common.vatLabel} {contact.registration.vat}</span>
        <span>{d.common.jibLabel} {contact.registration.jib}</span>
        <a
          href={href(locale, '/cookies')}
          class="transition-colors hover:text-flame-500"
        >
          {d.footer.cookiePolicy}
        </a>
        <button
          type="button"
          data-cookie-settings
          class="transition-colors hover:text-flame-500"
        >
          {d.footer.cookieSettings}
        </button>
      </p>
    </div>
  </div>
</footer>

<script>
  document
    .querySelectorAll<HTMLButtonElement>('[data-cookie-settings]')
    .forEach((el) =>
      el.addEventListener('click', () => window.mhCookieConsent?.open())
    );
</script>
