---
import Reveal from './Reveal.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  align?: 'left' | 'center';
  /** Heading level, so section headings stay in document order. */
  level?: 2 | 3;
  class?: string;
}

const {
  eyebrow,
  title,
  lede,
  align = 'left',
  level = 2,
  class: className = '',
} = Astro.props;

const Heading = `h${level}` as 'h2' | 'h3';
---

<div
  class:list={[
    'max-w-3xl',
    align === 'center' && 'mx-auto text-center',
    className,
  ]}
>
  {
    eyebrow && (
      <Reveal>
        <p class="eyebrow">{eyebrow}</p>
      </Reveal>
    )
  }

  <Reveal delay={eyebrow ? 80 : 0}>
    <Heading
      class="mt-4 text-3xl leading-[1.08] sm:text-4xl lg:text-[3.25rem] lg:leading-[1.05]"
    >
      {title}
    </Heading>
  </Reveal>

  {
    lede && (
      <Reveal delay={160}>
        <p class="lede mt-6">{lede}</p>
      </Reveal>
    )
  }
</div>
