---
import { t, asset, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
---

<section
  data-theme="dark"
  class="relative isolate grain flex min-h-[100svh] flex-col overflow-hidden bg-ink-950"
>
  <!-- Background: aerial orbit of the works. The poster carries the first paint;
       the video is only fetched once it can actually play. -->
  <div class="absolute inset-0 -z-10">
    <!-- Cooled and knocked back so the daylight footage sits inside the dark
         palette instead of fighting it. -->
    <img
      src={asset("/video/facility-poster.jpg")}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full scale-105 object-cover [filter:saturate(0.62)_contrast(1.08)_brightness(0.72)]"
    />
    <video
      data-hero-video
      data-src1080={asset('/video/facility-1080.mp4')}
      data-src720={asset('/video/facility-720.mp4')}
      poster={asset('/video/facility-poster.jpg')}
      autoplay
      muted
      loop
      playsinline
      preload="none"
      class="absolute inset-0 h-full w-full scale-105 object-cover opacity-0 transition-opacity duration-1000 [filter:saturate(0.62)_contrast(1.08)_brightness(0.72)]"
    >
    </video>
    <!-- Cyan cast ties the aerial back to the brand's second colour. -->
    <div class="absolute inset-0 bg-arc-600/12 mix-blend-color"></div>

    <div
      class="absolute inset-0 bg-linear-to-t from-ink-950 via-ink-950/55 to-ink-950/75"
    >
    </div>
    <div
      class="absolute inset-0 bg-linear-to-r from-ink-950/90 via-ink-950/30 to-transparent"
    >
    </div>
  </div>

  <div class="shell flex flex-1 flex-col justify-end pb-20 pt-32 lg:pb-28">
    <div class="max-w-4xl">
      <p
        data-reveal
        class="eyebrow flex items-center gap-3"
      >
        <span class="h-px w-10 bg-flame-500"></span>
        {d.home.heroEyebrow}
      </p>

      <h1
        data-reveal
        style="--reveal-delay:120ms"
        class="mt-6 text-[2.35rem] leading-[1.05] sm:text-5xl lg:text-[4.25rem] lg:leading-[1.02]"
      >
        <!-- Inline on small screens, split into two lines once there is room.
             The explicit {' '} is required: the build strips the whitespace
             between the two elements, which would run the words together. -->
        <span class="sm:block">{d.home.heroTitleA}</span>{' '}
        <span class="text-flame-500">{d.home.heroTitleB}</span>
      </h1>

      <p
        data-reveal
        style="--reveal-delay:240ms"
        class="lede mt-8 max-w-xl"
      >
        {d.home.heroLede}
      </p>
    </div>

  </div>
</section>

<script>
  // Pick a source by viewport, and only after the page has settled — the hero
  // must never compete with the poster or the fonts for early bandwidth.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');

  if (video) {
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    // `saveData` is non-standard but widely supported on the browsers where it
    // matters most; treat its absence as "no constraint".
    const connection = (navigator as any).connection;
    const saveData = Boolean(connection?.saveData);
    const slowNetwork = /2g/.test(connection?.effectiveType ?? '');

    if (!prefersReducedMotion && !saveData && !slowNetwork) {
      // Both paths arrive as data attributes rather than being written here.
      // A client <script> is a separate module from the frontmatter above, so
      // the `asset()` import is not in scope in it — and a literal path would
      // miss the /MH-website base and 404 on GitHub Pages.
      //
      // No hyphen before the digits: `data-src-1080` would key the dataset as
      // `src-1080`, because only a hyphen followed by a *letter* is camel-cased.
      // `video.dataset.src1080` would then be undefined and the hero silently
      // stay on its poster.
      const src =
        (window.innerWidth >= 1024
          ? video.dataset.src1080
          : video.dataset.src720) ?? '';

      const start = () => {
        if (!src) return;
        video.src = src;
        video.load();
        video.addEventListener(
          'canplay',
          () => {
            video.classList.remove('opacity-0');
            void video.play().catch(() => {
              /* Autoplay refused — the poster stays, which is fine. */
            });
          },
          { once: true }
        );
      };

      if (document.readyState === 'complete') start();
      else window.addEventListener('load', start, { once: true });
    }
  }
</script>
