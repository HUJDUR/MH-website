---
import { Image } from 'astro:assets';
import { img } from '../data/images';
import Button from './Button.astro';
import Reveal from './Reveal.astro';
import { t, href, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  eyebrow?: string;
  title?: string;
  body?: string;
  /** Button label; defaults to the shared "Reach out". */
  cta?: string;
  image?: string;
}

const { locale, image = 'welding-arc' } = Astro.props;
const d = t(locale);

// Defaults fall back to the contact page's copy in the active language.
// `heroLede` survives only for this fallback — the contact hero itself
// renders the title alone.
const eyebrow = Astro.props.eyebrow ?? d.contactPage.eyebrow;
const title = Astro.props.title ?? d.contactPage.heroTitle;
const body = Astro.props.body ?? d.contactPage.heroLede;
const cta = Astro.props.cta ?? d.common.requestQuote;
---

<section data-theme="dark" class="relative isolate grain overflow-hidden">
  <div class="absolute inset-0 -z-10">
    <Image
      src={img(image)}
      alt=""
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      loading="lazy"
      class="h-full w-full object-cover opacity-60"
    />
    <div class="absolute inset-0 bg-ink-950/55"></div>
    <div
      class="absolute inset-0 bg-linear-to-r from-ink-950 via-ink-950/75 to-ink-950/25"
    >
    </div>
  </div>

  <div class="shell py-24 lg:py-36">
    <div class="max-w-2xl">
      <Reveal>
        <p class="eyebrow">{eyebrow}</p>
      </Reveal>
      <Reveal delay={80}>
        <h2 class="mt-4 text-[1.75rem] leading-[1.12] sm:text-4xl lg:text-5xl">
          {title}
        </h2>
      </Reveal>
      <Reveal delay={160}>
        {/* `whitespace-pre-line` so a body can break its own lines: the copy is
            a plain string, and a newline in the dictionary is the only way to
            ask for one without markup. */}
        <p class="lede mt-6 whitespace-pre-line">{body}</p>
      </Reveal>
      <Reveal delay={240}>
        <div class="mt-10">
          <Button href={href(locale, '/contact')}>{cta}</Button>
        </div>
      </Reveal>
    </div>
  </div>
</section>
